---
import type { Block } from '../types/blocks'
import { cmsConfig } from '~site/cms.config'
import { defaultLocale as configDefaultLocale } from './i18n'

interface Props {
  blocks: Block[]
  /**
   * The locale this page is being built for, handed to every block.
   *
   * Until this existed a block could not know which tree it was in AT ALL: the only channel was
   * `Astro.currentLocale`, which is `undefined` on these sites because core builds the locale trees
   * itself (`buildStaticPaths`) and no site declares Astro's own `i18n` config. So every block
   * silently assumed the default locale — dates formatted in the wrong language on a translated
   * tree, and core's own controls announced in English everywhere (dashboard #1147).
   *
   * Optional, and defaulted, so a client repo keeps building unchanged across this bump; passing it
   * at the call site is what makes a non-default tree correct. Blocks that do not care about the
   * locale simply do not declare the prop.
   */
  locale?: string
  /**
   * The locale that routes at the root, unprefixed — a block needs this ALONGSIDE `locale` to
   * tell "this IS the default tree, no href rewriting needed" from "this is a translated tree".
   * Same optional/defaulted treatment as `locale`, for the same reason.
   */
  defaultLocale?: string
  /**
   * Default-locale page path → its own path per locale (`buildPathIndex`, core/i18n.ts), handed to
   * every block alongside `locale`/`defaultLocale` so `href()` (lib/href.ts) can resolve a
   * hand-typed internal link (a CTA, a nav item) to the CURRENT locale's address instead of
   * rendering whatever literal path an editor saw while typing it — always the default locale's.
   * Optional: a block that renders no internal href simply does not declare the prop.
   */
  pathIndex?: Record<string, Record<string, string>>
}
const { blocks, locale, defaultLocale, pathIndex } = Astro.props
const loc = locale ?? configDefaultLocale
const defLoc = defaultLocale ?? configDefaultLocale

const typesNeeded = new Set<string>(blocks.map((b) => b.type))
const registry: Record<string, any> = Object.fromEntries(
  await Promise.all(
    Object.entries(cmsConfig.blocks)
      .filter(([type]) => typesNeeded.has(type))
      .map(async ([type, loader]) => [type, (await loader()).default]),
  ),
)
---

{
  blocks.map((block) => {
    const Component = registry[block.type]
    if (!Component) return null
    // Handed to EVERY block, not only the ones core knows need it: a site's own block override is
    // registered through the same registry and has exactly the same problem to solve.
    return <Component block={block} locale={loc} defaultLocale={defLoc} pathIndex={pathIndex} />
  })
}
