---
// Cookie-consent banner (#521) — a simple window at the foot of the page. The component itself
// emits SEMANTIC MARKUP AND BEHAVIOUR ONLY, no inline styling: the look comes entirely from the
// `cookie-consent*` UnoCSS shortcuts (core/uno.core.ts) — a themed default on the site's own brand
// tokens, so a fresh client gets a real-looking banner immediately rather than a bare unstyled bar.
// A site overrides the look by redefining any of those shortcut keys in its own src/uno.ts (site
// keys win on collision, no !important) — the classnames on the markup below are the seam. It
// SELF-GATES on the client's consent switch alone (Settings → Privacy): an analytics id is NOT
// required, because this banner is about cookies and analytics is only today's source of them.
// Copy comes from the translatable `cookie_consent` global component, with built-in defaults so
// the banner works the moment consent is switched on, before any copy is authored.
//
// Pairs with ConsentMode.astro in <head>: that denies analytics by default; the buttons here
// flip the Consent Mode v2 signals to granted/denied and remember the choice in localStorage.
// When no tag loaded, ConsentMode does not render and `window.gtag` never exists — the signal
// call no-ops, the choice is still stored, and a later build that does load a tag replays it.
//
// GRANULAR MODE (#1226, opt-in per client via settings.cookie_consent_granular): every client
// defaults to the plain two-button banner below, unchanged. A client that opts in gets a THIRD
// button, "Customize", which reveals a second panel (Necessary — always on, no control; Statistics;
// Marketing) with its own confirm button. Accept/Reject stay one-click all-in/all-out shortcuts in
// BOTH modes — granular mode adds a path to a split choice, it does not remove the fast path.
//
// MODAL LAYOUT (#2495, opt-in per client via settings.cookie_consent_layout = modal): instead of the
// bar, a centred dialog over a dimmed page that has to be answered before the site can be used —
// the presentation Cookiebot uses by default. The page behind is `inert` and scroll-locked, focus
// starts on the dialog's title (never on Accept, which would nudge the answer) and stays inside it,
// and nothing but a choice closes it: no close button, no Esc, no backdrop click. Reject keeps the
// same size and weight as Accept, so it is a consent dialog and not a cookie wall. Two places keep
// the bar even on a modal client: the privacy page itself (a visitor must be able to read what they
// are asked to agree to), and any build without the setting. Its own `cookie-consent-modal*`
// shortcuts style it; the controls inside share the bar's keys, so a site's override of a button
// or of the granular panel reaches both layouts.
import { getSiteSettings, getCookieConsent, getPages } from '../lib/api'
import { CONSENT_SIGNALS_JS, resolveAnalytics } from './analytics'
import { consentCopyDefaults } from './consentCopy'
import { getEffectiveConfig } from './effectiveConfig'
import { pathForLocale } from './i18n'
import { resolvePrivacyHref } from './privacyHref'

interface Props {
  /** Locale of the page — drives the per-locale copy fetch and privacy-link resolution. */
  locale?: string
  /**
   * Where the banner's privacy link points when the CMS cannot say — a path or absolute URL owned
   * by the project layer, e.g. `/datenschutz` for a repo whose privacy notice is a hand-written
   * Astro route rather than a CMS page.
   *
   * The CMS still wins whenever it CAN answer: `settings.cookie_consent.privacy_page_id` resolving
   * to a real page takes precedence, so switching a site's notice into the CMS later needs no code
   * change here. This is the fallback for the case that has no configuration answer at all — the
   * page the link must reach does not exist in the CMS, so no id can name it, and the alternative
   * was a banner with no link on a site that has a privacy notice.
   */
  privacyHref?: string | null
}

const { locale = 'en', privacyHref: privacyHrefProp = null } = Astro.props

const settings = await getSiteSettings()

// The banner renders on the client's consent switch ALONE — not on whether a Google tag also
// resolved. `active` (what ConsentMode.astro loads a tag behind) is deliberately not read here:
// this banner is about COOKIES, and analytics is merely the only thing that sets one today. Both
// values still come from resolveAnalytics(), so the two components cannot drift apart on what
// "consent is on" means — only on what each of them does about it.
const { showBanner, granular, modal: modalLayout } = resolveAnalytics(settings)

const copy = showBanner ? await getCookieConsent(locale).catch(() => null) : null

// Built-in fallback copy (style-neutral, provider-agnostic) used until the CMS `cookie_consent`
// component is authored. A client localises/overrides it by writing that component — but the
// fallback is itself PER LOCALE now (consent-copy.json), because falling back to English on a
// Polish or Norwegian site meant the one piece of chrome that exists for legal reasons was the one
// piece a visitor could not read. A key that locale does not carry still comes from English.
const fallback = consentCopyDefaults(locale)

const message = copy?.message || fallback.message
const acceptLabel = copy?.accept_label || fallback.accept_label
const rejectLabel = copy?.reject_label || fallback.reject_label
const manageLabel = copy?.manage_label || fallback.manage_label

// Granular-mode-only copy — resolved even when `granular` is false (cheap; unused in that case)
// rather than threading a second condition through every line below.
const customizeLabel = copy?.customize_label || fallback.customize_label
const necessaryLabel = copy?.necessary_label || fallback.necessary_label
const alwaysOnLabel = copy?.always_on_label || fallback.always_on_label
const statisticsLabel = copy?.statistics_label || fallback.statistics_label
const statisticsDescription = copy?.statistics_description || fallback.statistics_description
const marketingLabel = copy?.marketing_label || fallback.marketing_label
const marketingDescription = copy?.marketing_description || fallback.marketing_description
const allowSelectionLabel = copy?.allow_selection_label || fallback.allow_selection_label

// Resolve the picked privacy page to its localized path, falling back to the path the project
// layer passed in. resolvePrivacyHref() owns the precedence rule and the blank-string guard.
let fromCms: string | null = null
const privacyId = settings.cookie_consent?.privacy_page_id
if (showBanner && typeof privacyId === 'number') {
  const [pages, { defaultLocale }] = await Promise.all([getPages(locale).catch(() => []), getEffectiveConfig()])
  const page = pages.find((p) => p.id === privacyId)

  // `pathForLocale`, not `page.path`. The comment above has always said "its localized path", but
  // `path` is the DEFAULT-locale address and lib/api.ts says so at the field: "Never use it to
  // decide whether a page is routable in THIS locale: that is pathForLocale(), off translations[]."
  // Reading it here pointed the banner's privacy link at the default locale's page on every
  // translated tree — the same defect as the teaser cards in dashboard#1454, in the one piece of
  // chrome that exists for legal reasons. Measured on diligently.pl: `/cookie-declaration/` on
  // /pl/, where the Polish notice lives at `/pl/deklaracja-cookie/`.
  //
  // The default locale comes from getEffectiveConfig (the CMS-resolved one, #1195), not the
  // module constant, so a client whose panel disagrees with its cms.config.ts still resolves right.
  fromCms = page ? pathForLocale(page, locale, defaultLocale) : null
}
const privacyHref = showBanner ? resolvePrivacyHref(fromCms, privacyHrefProp) : null

// The privacy page never blocks (#2495): the modal asks a visitor to agree to what that page
// explains, so covering it would make the explanation unreachable. Compared as paths with the
// trailing slash dropped, so `/privacy` and `/privacy/` (and an absolute URL to this same page)
// count as the same page.
function samePath(href: string, pathname: string): boolean {
  let target: string
  try {
    target = new URL(href, Astro.url).pathname
  } catch {
    return false
  }
  const strip = (path: string) => path.replace(/\/+$/, '') || '/'
  return strip(target) === strip(pathname)
}
const onPrivacyPage = privacyHref !== null && samePath(privacyHref, Astro.url.pathname)
const modal = modalLayout && !onPrivacyPage
// Markup: on the bar the outer element IS the dialog, as it always was. In the modal it is the
// dimmed backdrop and the dialog is the card inside it — so `hidden`, which the script toggles on
// the outer element, shows and hides backdrop and card together in both layouts.

// The title always shows in the modal, where it also names the dialog for assistive tech. On the
// bar it shows only once an editor wrote one, so a client that never opted in sees no change.
const title = copy?.title || (modal ? fallback.title : '')

// One script serves both modes: the granular-only elements (customize button, panel, the two
// checkboxes) are simply absent from the DOM in simple mode, and every handler below null-guards
// its lookup — so this file has no separate "granular" code path to keep in sync with the plain one.
const consentScript = `
${CONSENT_SIGNALS_JS}
(function(){
  var el = document.querySelector('[data-cookie-consent]');
  if (!el) return;
  // Modal layout (#2495): everything outside the dialog goes \`inert\` (unreachable by pointer,
  // keyboard and assistive tech) and the page stops scrolling until the visitor answers; both are
  // undone on close, and focus goes back to whatever opened it (the footer's settings link).
  var isModal = el.hasAttribute('data-cookie-consent-modal');
  var inerted = [];
  var lastFocus = null;
  var prevOverflow = '';
  function lockPage(){
    lastFocus = document.activeElement;
    for (var node = el; node && node.parentElement && node !== document.body; node = node.parentElement) {
      var siblings = node.parentElement.children;
      for (var i = 0; i < siblings.length; i++) {
        var sib = siblings[i];
        if (sib !== node && !sib.inert && sib.tagName !== 'SCRIPT' && sib.tagName !== 'STYLE') { sib.inert = true; inerted.push(sib); }
      }
    }
    prevOverflow = document.documentElement.style.overflow;
    document.documentElement.style.overflow = 'hidden';
    var start = el.querySelector('[data-cookie-consent-title]') || el.querySelector('button');
    if (start) { try { start.focus({ preventScroll: true }); } catch(e) { start.focus(); } }
  }
  function unlockPage(){
    for (var i = 0; i < inerted.length; i++) inerted[i].inert = false;
    inerted = [];
    document.documentElement.style.overflow = prevOverflow;
    if (lastFocus && lastFocus !== document.body && typeof lastFocus.focus === 'function' && document.contains(lastFocus)) lastFocus.focus();
    lastFocus = null;
  }
  function open(){ if (!el.hidden) return; el.hidden = false; if (isModal) lockPage(); }
  function close(){ if (el.hidden) return; el.hidden = true; if (isModal) unlockPage(); }
  // Keeps Tab inside the dialog where \`inert\` is unsupported (older Safari); harmless elsewhere.
  if (isModal) el.addEventListener('keydown', function(e){
    if (e.key !== 'Tab') return;
    var f = Array.prototype.filter.call(el.querySelectorAll('button, a[href], input'), function(n){ return n.offsetParent !== null; });
    if (!f.length) return;
    var first = f[0], last = f[f.length - 1], active = document.activeElement;
    var outside = f.indexOf(active) === -1;
    if (e.shiftKey && (active === first || outside)) { e.preventDefault(); last.focus(); }
    else if (!e.shiftKey && (active === last || outside)) { e.preventDefault(); first.focus(); }
  });
  // Every way out of the banner is the same three steps in the same order — remember the choice,
  // signal it to Consent Mode, dismiss. Accept and Reject are just fixed values of that one path.
  // writeCookieConsent() is a POST to the site's own origin since #1470 and so completes later,
  // but the other two steps depend on the VALUE and not on the write, so the banner still closes
  // and the tag is still ungated in the same tick; a write that fails falls back to localStorage.
  // The fourth step is for anything that is NOT a Google tag: CustomCode.astro holds a
  // statistics/marketing snippet inert until this fires (#1805). Consent Mode signals reach gtag
  // through dataLayer, which a pasted third-party snippet knows nothing about.
  function decide(v){ writeCookieConsent(v); applyCookieConsent(v); notify(v); close(); }
  function notify(v){ try { document.dispatchEvent(new CustomEvent('cms:consent', { detail: v })); } catch(e) {} }
  var existing = readCookieConsent();
  if (!existing) open();

  var acceptBtn = el.querySelector('[data-cookie-consent-accept]');
  var rejectBtn = el.querySelector('[data-cookie-consent-reject]');
  if (acceptBtn) acceptBtn.addEventListener('click', function(){ decide({statistics:true,marketing:true}); });
  if (rejectBtn) rejectBtn.addEventListener('click', function(){ decide({statistics:false,marketing:false}); });

  var customizeBtn = el.querySelector('[data-cookie-consent-customize]');
  var panel = el.querySelector('[data-cookie-consent-panel]');
  var statsInput = el.querySelector('[data-cookie-consent-statistics]');
  var marketingInput = el.querySelector('[data-cookie-consent-marketing]');
  if (customizeBtn && panel) {
    // Reopening Customize shows the visitor's last decision, not always unchecked.
    if (statsInput) statsInput.checked = !!(existing && existing.statistics);
    if (marketingInput) marketingInput.checked = !!(existing && existing.marketing);
    customizeBtn.addEventListener('click', function(){
      panel.hidden = false;
      customizeBtn.setAttribute('aria-expanded', 'true');
    });
  }
  var allowSelectionBtn = el.querySelector('[data-cookie-consent-allow-selection]');
  if (allowSelectionBtn) allowSelectionBtn.addEventListener('click', function(){
    decide({
      statistics: !!(statsInput && statsInput.checked),
      marketing: !!(marketingInput && marketingInput.checked)
    });
  });

  document.querySelectorAll('[data-cookie-consent-open]').forEach(function(t){ t.addEventListener('click', function(e){ e.preventDefault(); open(); }); });
})();
`.trim()
---

{
  showBanner && (
    <div
      class={modal ? 'cookie-consent-modal' : 'cookie-consent'}
      role={modal ? undefined : 'dialog'}
      aria-live={modal ? undefined : 'polite'}
      aria-label={modal || title ? undefined : manageLabel}
      aria-labelledby={!modal && title ? 'cookie-consent-title' : undefined}
      data-cookie-consent
      data-cookie-consent-modal={modal ? '' : undefined}
      hidden
    >
      {/* `contents` on the bar: no box of its own, so the bar's flex layout is what it always was. */}
      <div
        class={modal ? 'cookie-consent-modal__dialog' : 'contents'}
        role={modal ? 'dialog' : undefined}
        aria-modal={modal ? 'true' : undefined}
        aria-labelledby={modal ? 'cookie-consent-title' : undefined}
        aria-describedby={modal ? 'cookie-consent-message' : undefined}
      >
      <div class={modal ? 'cookie-consent-modal__top' : 'cookie-consent__top'}>
        <div class={modal ? 'cookie-consent-modal__text' : 'cookie-consent__text'}>
          {title && (
            <h2
              id="cookie-consent-title"
              class={modal ? 'cookie-consent-modal__title' : 'cookie-consent__title'}
              tabindex="-1"
              data-cookie-consent-title
            >
              {title}
            </h2>
          )}
          <p id="cookie-consent-message" class={modal ? 'cookie-consent-modal__message' : 'cookie-consent__message'}>
            {message}
            {privacyHref && (
              <>
                {' '}
                <a class="cookie-consent__link" href={privacyHref}>
                  {manageLabel}
                </a>
              </>
            )}
          </p>
        </div>
        <div class={modal ? 'cookie-consent-modal__actions' : 'cookie-consent__actions'}>
          {granular && !modal && (
            <button
              type="button"
              class="cookie-consent__customize"
              aria-expanded="false"
              aria-controls="cookie-consent-panel"
              data-cookie-consent-customize
            >
              {customizeLabel}
            </button>
          )}
          {/* Reject is presented first and is the same kind of control as Accept — not a dark pattern. */}
          <button
            type="button"
            class="cookie-consent__button cookie-consent__button--reject"
            data-cookie-consent-reject
          >
            {rejectLabel}
          </button>
          <button
            type="button"
            class="cookie-consent__button cookie-consent__button--accept"
            data-cookie-consent-accept
          >
            {acceptLabel}
          </button>
          {/* Modal: Customize sits under the two choices, so it comes after them in the markup too. */}
          {granular && modal && (
            <button
              type="button"
              class="cookie-consent-modal__customize"
              aria-expanded="false"
              aria-controls="cookie-consent-panel"
              data-cookie-consent-customize
            >
              {customizeLabel}
            </button>
          )}
        </div>
      </div>
      {granular && (
        <div class="cookie-consent__panel" id="cookie-consent-panel" data-cookie-consent-panel hidden>
          <div class="cookie-consent__category">
            <div class="cookie-consent__category-header">
              <span class="cookie-consent__category-label">{necessaryLabel}</span>
              <span class="cookie-consent__category-badge">{alwaysOnLabel}</span>
            </div>
          </div>
          <div class="cookie-consent__category">
            <label class="cookie-consent__category-header" for="cookie-consent-statistics">
              <span class="cookie-consent__category-label">{statisticsLabel}</span>
              <input
                type="checkbox"
                id="cookie-consent-statistics"
                class="cookie-consent__toggle"
                data-cookie-consent-statistics
              />
            </label>
            <p class="cookie-consent__category-description">{statisticsDescription}</p>
          </div>
          <div class="cookie-consent__category">
            <label class="cookie-consent__category-header" for="cookie-consent-marketing">
              <span class="cookie-consent__category-label">{marketingLabel}</span>
              <input
                type="checkbox"
                id="cookie-consent-marketing"
                class="cookie-consent__toggle"
                data-cookie-consent-marketing
              />
            </label>
            <p class="cookie-consent__category-description">{marketingDescription}</p>
          </div>
          <button
            type="button"
            class="cookie-consent__button cookie-consent__button--accept cookie-consent__allow-selection"
            data-cookie-consent-allow-selection
          >
            {allowSelectionLabel}
          </button>
        </div>
      )}
      </div>
    </div>
  )
}

{showBanner && <script is:inline set:html={consentScript} />}
