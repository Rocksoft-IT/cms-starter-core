---
// Cookie-consent banner (#521) — a simple window at the foot of the page. The component itself
// emits SEMANTIC MARKUP AND BEHAVIOUR ONLY, no inline styling: the look comes entirely from the
// `cookie-consent*` UnoCSS shortcuts (core/uno.core.ts) — a themed default on the site's own brand
// tokens, so a fresh client gets a real-looking banner immediately rather than a bare unstyled bar.
// A site overrides the look by redefining any of those shortcut keys in its own src/uno.ts (site
// keys win on collision, no !important) — the classnames on the markup below are the seam. It
// SELF-GATES — nothing renders unless the client enabled consent AND has an analytics id (there is
// nothing to gate otherwise). Copy comes from the translatable `cookie_consent` global component,
// with built-in defaults so the banner works the moment consent is switched on, before any copy is
// authored.
//
// Pairs with ConsentMode.astro in <head>: that denies analytics by default; the buttons here
// flip the Consent Mode v2 signals to granted/denied and remember the choice in localStorage.
//
// GRANULAR MODE (#1226, opt-in per client via settings.cookie_consent_granular): every client
// defaults to the plain two-button banner below, unchanged. A client that opts in gets a THIRD
// button, "Customize", which reveals a second panel (Necessary — always on, no control; Statistics;
// Marketing) with its own confirm button. Accept/Reject stay one-click all-in/all-out shortcuts in
// BOTH modes — granular mode adds a path to a split choice, it does not remove the fast path.
import { getSiteSettings, getCookieConsent, getPages } from '../lib/api'
import { CONSENT_SIGNALS_JS, resolveAnalytics } from './analytics'

interface Props {
  /** Locale of the page — drives the per-locale copy fetch and privacy-link resolution. */
  locale?: string
}

const { locale = 'en' } = Astro.props

const settings = await getSiteSettings()

// The same gate ConsentMode.astro loads the tag behind — shared rather than re-derived, because
// the two used to disagree: a malformed id (say a `GT-` one, refused by the old loader) counted
// as "has analytics" here and produced a banner asking about tracking that was never installed.
const { active, granular } = resolveAnalytics(settings)

const copy = active ? await getCookieConsent(locale).catch(() => null) : null

// Built-in fallback copy (style-neutral, provider-agnostic) used until the CMS `cookie_consent`
// component is authored. A client localises/overrides it by writing that component.
const message =
  copy?.message || 'We use cookies to measure traffic. Accept to allow analytics, or reject to keep them off.'
const acceptLabel = copy?.accept_label || 'Accept'
const rejectLabel = copy?.reject_label || 'Reject'
const manageLabel = copy?.manage_label || 'Privacy policy'

// Granular-mode-only copy — resolved even when `granular` is false (cheap; unused in that case)
// rather than threading a second condition through every line below.
const customizeLabel = copy?.customize_label || 'Customize'
const necessaryLabel = copy?.necessary_label || 'Necessary'
const alwaysOnLabel = copy?.always_on_label || 'Always on'
const statisticsLabel = copy?.statistics_label || 'Statistics'
const statisticsDescription = copy?.statistics_description || 'Helps us understand how visitors use this site.'
const marketingLabel = copy?.marketing_label || 'Marketing'
const marketingDescription = copy?.marketing_description || 'Used to measure and improve ad performance.'
const allowSelectionLabel = copy?.allow_selection_label || 'Allow selection'

// Resolve the picked privacy page to its localized path (or omit the link when unset/unresolved).
let privacyHref: string | null = null
const privacyId = settings.cookie_consent?.privacy_page_id
if (active && typeof privacyId === 'number') {
  const pages = await getPages(locale).catch(() => [])
  privacyHref = pages.find((p) => p.id === privacyId)?.path ?? null
}

// One script serves both modes: the granular-only elements (customize button, panel, the two
// checkboxes) are simply absent from the DOM in simple mode, and every handler below null-guards
// its lookup — so this file has no separate "granular" code path to keep in sync with the plain one.
const consentScript = `
${CONSENT_SIGNALS_JS}
(function(){
  var el = document.querySelector('[data-cookie-consent]');
  if (!el) return;
  function open(){ el.hidden = false; }
  function close(){ el.hidden = true; }
  // Every way out of the banner is the same three steps in the same order — remember the choice,
  // signal it to Consent Mode, dismiss. Accept and Reject are just fixed values of that one path.
  function decide(v){ writeCookieConsent(v); applyCookieConsent(v); close(); }
  var existing = readCookieConsent();
  if (!existing) open();

  var acceptBtn = el.querySelector('[data-cookie-consent-accept]');
  var rejectBtn = el.querySelector('[data-cookie-consent-reject]');
  if (acceptBtn) acceptBtn.addEventListener('click', function(){ decide({statistics:true,marketing:true}); });
  if (rejectBtn) rejectBtn.addEventListener('click', function(){ decide({statistics:false,marketing:false}); });

  var customizeBtn = el.querySelector('[data-cookie-consent-customize]');
  var panel = el.querySelector('[data-cookie-consent-panel]');
  var statsInput = el.querySelector('[data-cookie-consent-statistics]');
  var marketingInput = el.querySelector('[data-cookie-consent-marketing]');
  if (customizeBtn && panel) {
    // Reopening Customize shows the visitor's last decision, not always unchecked.
    if (statsInput) statsInput.checked = !!(existing && existing.statistics);
    if (marketingInput) marketingInput.checked = !!(existing && existing.marketing);
    customizeBtn.addEventListener('click', function(){
      panel.hidden = false;
      customizeBtn.setAttribute('aria-expanded', 'true');
    });
  }
  var allowSelectionBtn = el.querySelector('[data-cookie-consent-allow-selection]');
  if (allowSelectionBtn) allowSelectionBtn.addEventListener('click', function(){
    decide({
      statistics: !!(statsInput && statsInput.checked),
      marketing: !!(marketingInput && marketingInput.checked)
    });
  });

  document.querySelectorAll('[data-cookie-consent-open]').forEach(function(t){ t.addEventListener('click', function(e){ e.preventDefault(); open(); }); });
})();
`.trim()
---

{
  active && (
    <div class="cookie-consent" role="dialog" aria-live="polite" aria-label={manageLabel} data-cookie-consent hidden>
      <div class="cookie-consent__top">
        <p class="cookie-consent__message">
          {message}
          {privacyHref && (
            <>
              {' '}
              <a class="cookie-consent__link" href={privacyHref}>
                {manageLabel}
              </a>
            </>
          )}
        </p>
        <div class="cookie-consent__actions">
          {granular && (
            <button
              type="button"
              class="cookie-consent__customize"
              aria-expanded="false"
              aria-controls="cookie-consent-panel"
              data-cookie-consent-customize
            >
              {customizeLabel}
            </button>
          )}
          {/* Reject is presented first and is the same kind of control as Accept — not a dark pattern. */}
          <button type="button" class="cookie-consent__button cookie-consent__button--reject" data-cookie-consent-reject>
            {rejectLabel}
          </button>
          <button type="button" class="cookie-consent__button cookie-consent__button--accept" data-cookie-consent-accept>
            {acceptLabel}
          </button>
        </div>
      </div>
      {granular && (
        <div class="cookie-consent__panel" id="cookie-consent-panel" data-cookie-consent-panel hidden>
          <div class="cookie-consent__category">
            <div class="cookie-consent__category-header">
              <span class="cookie-consent__category-label">{necessaryLabel}</span>
              <span class="cookie-consent__category-badge">{alwaysOnLabel}</span>
            </div>
          </div>
          <div class="cookie-consent__category">
            <label class="cookie-consent__category-header" for="cookie-consent-statistics">
              <span class="cookie-consent__category-label">{statisticsLabel}</span>
              <input type="checkbox" id="cookie-consent-statistics" class="cookie-consent__toggle" data-cookie-consent-statistics />
            </label>
            <p class="cookie-consent__category-description">{statisticsDescription}</p>
          </div>
          <div class="cookie-consent__category">
            <label class="cookie-consent__category-header" for="cookie-consent-marketing">
              <span class="cookie-consent__category-label">{marketingLabel}</span>
              <input type="checkbox" id="cookie-consent-marketing" class="cookie-consent__toggle" data-cookie-consent-marketing />
            </label>
            <p class="cookie-consent__category-description">{marketingDescription}</p>
          </div>
          <button
            type="button"
            class="cookie-consent__button cookie-consent__button--accept cookie-consent__allow-selection"
            data-cookie-consent-allow-selection
          >
            {allowSelectionLabel}
          </button>
        </div>
      )}
    </div>
  )
}

{active && <script is:inline set:html={consentScript} />}
