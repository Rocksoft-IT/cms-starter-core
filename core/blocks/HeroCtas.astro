---
// The hero's call-to-action cluster: its buttons, the CTA card beside them, and the
// reassurance line under them.
//
// Extracted because it was the piece that went missing. `Hero.astro` renders two layouts, and
// `ctas` was written into only one of them — a hero with nested columns dropped its buttons
// entirely, silently, while the field stayed filled in the panel. `cta_note` (dashboard#1354) was
// never written into either. One component rendered from both branches is what stops a third
// layout losing them again.
//
// It lives in `core/blocks/` rather than beside the other shared components on purpose: the field
// -coverage gate follows delegates only into `blocks/` and `lib/`, so a hero helper anywhere else
// would make `ctas` and `cta_note` read as unrendered on a block that renders them fine.
import type { HeroBlock } from '../../types/blocks'
import { href as hrefOf } from '../../lib/href'
import { usableCtas } from '../../lib/ctas'
import { alignClasses } from '../../lib/align'

interface Props {
  ctas?: HeroBlock['data']['ctas']
  cta_note?: string
  cta_card_image?: HeroBlock['data']['cta_card_image']
  cta_card_title?: string
  cta_card_subtitle?: string
  cta_card_href?: string
  /**
   * The hero's `align` token ($sectionAlign, #1643). The button row is a flex ROW, so its
   * horizontal axis is `justify-content` — `align-row`, not the `align-column` the stacked
   * clusters take. The note under the buttons is ordinary text and follows the `align-text` its
   * parent track carries. See lib/align.ts.
   */
  align?: string
  /** Locale context for resolving an internal href — from core/BlockRenderer.astro via Hero.astro. */
  locale?: string
  defaultLocale?: string
  pathIndex?: Record<string, Record<string, string>>
}

const { cta_note, align, cta_card_image, cta_card_title, cta_card_subtitle, cta_card_href, locale, defaultLocale, pathIndex } =
  Astro.props
const hrefCtx = locale && defaultLocale ? { locale, defaultLocale, pathIndex } : undefined

// A row saved with only half its pair is an unfinished input, not an instruction to draw an empty
// link — the same rule the two other blocks fed by `$ctaList` now follow. See lib/ctas.ts.
const ctas = usableCtas(Astro.props.ctas)
---

{
  (ctas.length > 0 || cta_card_title) && (
    <div class:list={['hero-ctas', ...alignClasses(align, 'align-row')]}>
      {ctas.map((cta, i) => (
        <a href={hrefOf(cta.href, hrefCtx)} class={i === 0 ? 'btn-primary' : 'btn-outline'}>
          {cta.label}
        </a>
      ))}

      {/* The CTA card (dashboard#1711, renamed from `advisor_*`): a picture, a strong line and
          a quiet one, standing as a pill beside the buttons. Usually the person to talk to, but
          the fields do not presume it — a partner mark or a certification is the same shape.
          `cta_card_title` alone gates it, so a hero setting none of the four renders exactly as
          it did before they existed. `hrefOf` returns undefined for an empty field, so the
          attribute is dropped rather than emitted empty — an <a> with no href is a valid inert
          placeholder, where href="" would link back to the current page. The photo takes alt="":
          the link's own text already carries both lines, so an alt would only make its
          accessible name say them twice. */}
      {cta_card_title && (
        <a href={hrefOf(cta_card_href, hrefCtx)} class="hero-cta-card">
          {cta_card_image && (
            <span class="hero-cta-card-photo">
              <img src={cta_card_image} width="40" height="40" alt="" decoding="async" />
            </span>
          )}
          <span class="hero-cta-card-text">
            <strong class="hero-cta-card-title">{cta_card_title}</strong>
            {cta_card_subtitle && <span class="hero-cta-card-subtitle">{cta_card_subtitle}</span>}
          </span>
        </a>
      )}
    </div>
  )
}

{cta_note && <p class="hero-cta-note">{cta_note}</p>}
