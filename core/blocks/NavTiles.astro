---
// Core "quick-access tiles" block (nav_tiles). Renders a responsive grid of tiles, each a
// keyboard-focusable link with an optional icon and a label. A tile flagged `highlighted`
// gets an emphasized, featured variant (accent border + tint) so one entry can stand out —
// e.g. the SMBP home "Pod ręką, bez szukania" panel where the "Przetargi" tile is featured.
//
// Graceful degradation: a tile with no `icon` simply drops the image (the label still reads),
// a tile with no `href` renders as a non-navigating card, and an empty `tiles` list renders
// nothing at all.
//
// Visual values live in the `nav-tile*` shortcuts (core/uno.core.ts) and resolve as brand theme
// colors, so a site rethemes the grid by redefining a shortcut in its src/uno.ts. Only the
// featured-variant token seam and the reduced-motion opt-out remain as scoped CSS below.
import type { NavTilesBlock } from '../../types/blocks'

interface Props {
  block: NavTilesBlock
}

const { block } = Astro.props
const { heading, tiles = [] } = block.data

// A tile only navigates if it has an href; otherwise it degrades to a plain card so a
// half-authored tile never emits an empty, focusable `<a href>` that goes nowhere.
const renderable = tiles.filter((tile) => tile?.label || tile?.icon)
---

{
  renderable.length > 0 && (
    <section class="section-nav-tiles">
      <div class="nav-tiles-inner">
        {heading && <h2 class="nav-tiles-heading">{heading}</h2>}
        <ul class="nav-tiles-grid" role="list">
          {renderable.map((tile) => {
            const Tag = tile.href ? 'a' : 'div'
            const props = tile.href ? { href: tile.href } : {}
            return (
              <li>
                <Tag
                  class:list={[
                    'nav-tile',
                    // Hover lift and focus ring only where there is somewhere to go.
                    tile.href && 'nav-tile-interactive',
                    { 'nav-tile-highlighted': tile.highlighted },
                  ]}
                  {...props}
                >
                  {tile.icon && (
                    <span class="nav-tile-icon">
                      <img src={tile.icon} alt="" aria-hidden="true" loading="lazy" />
                    </span>
                  )}
                  {tile.label && <span class="nav-tile-label">{tile.label}</span>}
                </Tag>
              </li>
            )
          })}
        </ul>
      </div>
    </section>
  )
}

<style>
  /* `@layer core` keeps these the weakest declarations on the page, so a site's own CSS and every
     Uno utility outrank them without !important. */
  @layer core {
    /* Featured variant — the emphasized tile an editor toggles with `highlighted`. Its color is
       the dedicated `--color-nav-tile-featured` token, falling back to `--color-accent` so sites
       that don't set it keep the previous look. A site whose `accent` means something else (smbp:
       the amber "awarie" icon; the CMS also maps branding.accent_color onto `accent`) sets this
       token to the color the design wants featured (smbp: brand-dark2). It stays CSS because it is
       an OPTIONAL seam: unlike the palette keys the shortcuts consume, a site need not define it,
       so it must not become a required theme color. */
    .nav-tile-highlighted {
      background: var(--color-nav-tile-featured, var(--color-accent));
      border-color: var(--color-nav-tile-featured, var(--color-accent));
      color: #ffffff;
    }

    a.nav-tile-highlighted:hover {
      border-color: var(--color-nav-tile-featured, var(--color-accent));
      box-shadow: 0 12px 30px rgb(0 0 0 / 28%);
    }

    a.nav-tile-highlighted:focus-visible {
      outline-color: var(--color-nav-tile-featured, var(--color-accent));
    }
  }
</style>
