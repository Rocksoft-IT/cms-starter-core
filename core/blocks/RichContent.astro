---
import type { RichContentBlock } from '../../types/blocks'
import { sectionAnchorId } from '../../lib/anchor'
import { backgroundClass } from '../../lib/background'
import RichText from '../RichText.astro'
interface Props {
  block: RichContentBlock
}
const { block } = Astro.props
const { anchor_id, background } = block.data

// Deep-link target, so a table of contents can point at this block (#1416). See lib/anchor.ts.
const sectionId = sectionAnchorId(anchor_id)
---

<section class:list={['section-content', backgroundClass(background)]} id={sectionId}>
  <div class="content-inner">
    {block.data.heading && <h2 class="rich-heading">{block.data.heading}</h2>}
    <RichText class="rich-body" html={block.data.body} />
  </div>
</section>
