---
// Core testimonials block (collection-ref): `data.items` arrives resolved server-side from
// the `testimonial` collection (hand-maintained TestimonialsItem in src/types/blocks.ts).
// Two layouts over the same markup: `slider` (sliding track + arrows + autoplay) and
// `single` (plain stacked cards). Every field is optional and degrades gracefully — an
// empty resolved collection renders just the header, or no section at all.
import type { TestimonialsBlock } from '../../types/blocks'
import RichText from '../RichText.astro'
import SectionHeader from '../SectionHeader.astro'
import { coreString } from '../ui-strings'
import { backgroundClass } from '../../lib/background'

interface Props {
  block: TestimonialsBlock
  /** The locale this page is being built for, from core/BlockRenderer.astro. */
  locale?: string
}

const { block, locale } = Astro.props
const { eyebrow, heading, layout = 'slider', items = [], background } = block.data

const hasHeader = Boolean(eyebrow || heading)

// Slider chrome only makes sense with more than one item; the `single` layout — or a
// slider with a single item — renders the stacked default instead.
const isSlider = layout === 'slider' && items.length > 1

// Arrow buttons and their click handlers are driven from one direction table; the inline
// script reads `data-dir`. The labels are screen-reader-only and have no CMS field, so they come
// from core's own per-locale table (core/ui-strings.ts) — the seam this comment used to say did
// not exist yet.
const arrows = [
  { dir: -1, label: coreString(locale, 'previousTestimonial'), path: 'M15 18l-6-6 6-6' },
  { dir: 1, label: coreString(locale, 'nextTestimonial'), path: 'M9 18l6-6-6-6' },
]

// A card with no photo shows a neutral initial placeholder instead — same avatar
// treatment as Team.astro.
function initial(name?: string) {
  return name?.trim().charAt(0).toUpperCase() || ''
}
---

{
  (hasHeader || items.length > 0) && (
    <section class:list={['section-testimonials py-16 section-surface', backgroundClass(background)]}>
      <div class="container-global">
        <SectionHeader {eyebrow} {heading} />

        {items.length > 0 && (
          <div class:list={['testimonials-list', isSlider && 'is-slider relative']}>
            {/* One shared star shape per section; each rendered star is a tiny <use> ref. */}
            <svg class="hidden" aria-hidden="true">
              <symbol id="tm-star" viewBox="0 0 18 17">
                <path d="M8.16379 0.551109C8.47316 -0.183704 9.52684 -0.183703 9.83621 0.551111L11.6621 4.88811C11.7926 5.19789 12.0875 5.40955 12.426 5.43636L17.1654 5.81173C17.9684 5.87533 18.294 6.86532 17.6822 7.38306L14.0713 10.4388C13.8134 10.6571 13.7007 10.9996 13.7795 11.3259L14.8827 15.8949C15.0696 16.669 14.2172 17.2809 13.5297 16.8661L9.47208 14.4176C9.18225 14.2427 8.81775 14.2427 8.52793 14.4176L4.47029 16.8661C3.7828 17.2809 2.93036 16.669 3.11727 15.8949L4.22048 11.3259C4.29928 10.9996 4.18664 10.6571 3.92873 10.4388L0.317756 7.38306C-0.294046 6.86532 0.0315611 5.87533 0.834562 5.81173L5.57402 5.43636C5.91255 5.40955 6.20744 5.19789 6.33786 4.88811L8.16379 0.551109Z" />
              </symbol>
            </svg>

            <div class="testimonial-mask">
              <div class="testimonial-track">
                {items.map((item) => {
                  const stars = item.rating != null ? Math.min(5, Math.max(1, Math.round(item.rating))) : null
                  return (
                    <div class="testimonial-slide">
                      <figure class="m-0 h-full bg-section-bg rounded-[16px] p-10 flex flex-col justify-between items-start gap-6">
                        {stars != null && (
                          <div class="flex gap-1 text-primary" role="img" aria-label={`${stars}/5`}>
                            {Array.from({ length: stars }).map(() => (
                              <svg class="w-5 h-5" fill="currentColor" aria-hidden="true">
                                <use href="#tm-star" />
                              </svg>
                            ))}
                          </div>
                        )}
                        <blockquote class="m-0 p-0 border-0 flex-1 text-left">
                          <RichText class="section-intro" html={item.quote} />
                        </blockquote>
                        <figcaption class="flex items-center gap-3 text-left">
                          {item.photo ? (
                            <img
                              src={item.photo}
                              alt=""
                              class="w-12 h-12 rounded-full object-cover"
                              loading="lazy"
                              width="48"
                              height="48"
                            />
                          ) : (
                            item.author && (
                              <span
                                class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-body font-bold text-text-secondary"
                                aria-hidden="true"
                              >
                                {initial(item.author)}
                              </span>
                            )
                          )}
                          <div class="flex flex-col">
                            {item.author && <p class="font-bold m-0">{item.author}</p>}
                            {(item.role || item.company) && (
                              <p class="text-[14px] text-text-secondary m-0">
                                {item.role}
                                {item.role && item.company && ' · '}
                                {item.company &&
                                  (item.company_url ? (
                                    <a
                                      href={item.company_url}
                                      target="_blank"
                                      rel="noopener noreferrer"
                                      class="text-text-secondary underline"
                                    >
                                      {item.company}
                                    </a>
                                  ) : (
                                    item.company
                                  ))}
                              </p>
                            )}
                          </div>
                        </figcaption>
                      </figure>
                    </div>
                  )
                })}
              </div>
            </div>

            {isSlider &&
              arrows.map((arrow) => (
                <button
                  type="button"
                  class:list={[
                    'testimonial-arrow absolute top-1/2 -translate-y-1/2 z-1 w-11 h-11',
                    'flex items-center justify-center rounded-[8px] border-none cursor-pointer',
                    'bg-text-primary text-body',
                    arrow.dir < 0 ? 'left-0' : 'right-0',
                  ]}
                  data-dir={arrow.dir}
                  aria-label={arrow.label}
                >
                  <svg
                    width="20"
                    height="20"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d={arrow.path} />
                  </svg>
                </button>
              ))}
          </div>
        )}
      </div>
    </section>
  )
}

{
  /* Only slider pages ship any JS (same conditional is:inline pattern as Hero.astro; the
     emitted-verbatim set:html caveat documented there applies here too). Instances beyond
     the first are no-ops via the data-slider-init guard. */
  isSlider && (
    <script
      is:inline
      set:html={`document.querySelectorAll('.testimonials-list.is-slider').forEach(function (wrapper) {
        if (wrapper.dataset.sliderInit) return
        wrapper.dataset.sliderInit = '1'
        var track = wrapper.querySelector('.testimonial-track')
        if (!track) return
        var count = track.children.length
        var current = 0
        var timer = null
        var autoplay = !window.matchMedia('(prefers-reduced-motion: reduce)').matches

        function goTo(index) {
          current = ((index % count) + count) % count
          track.style.transform = 'translateX(-' + current * 100 + '%)'
        }

        function restartAutoplay() {
          clearInterval(timer)
          if (autoplay) {
            timer = setInterval(function () { goTo(current + 1) }, 4000)
          }
        }

        wrapper.querySelectorAll('.testimonial-arrow').forEach(function (btn) {
          btn.addEventListener('click', function () {
            goTo(current + Number(btn.dataset.dir))
            restartAutoplay()
          })
        })

        // Tick only while the slider is actually on screen.
        new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            if (entry.isIntersecting) restartAutoplay()
            else clearInterval(timer)
          })
        }).observe(wrapper)
      })`}
    />
  )
}
