---
// Core highlights block (grouped list): categories of name/description/price rows under a
// shared header — a menu- or price-list-style section. Optional links row and a small-print
// footnote close it out. Every field is optional and degrades gracefully.
import type { HighlightsBlock } from '../../types/blocks'
import SectionHeader from '../SectionHeader.astro'
import { href as hrefOf } from '../../lib/href'
import { sectionAnchorId } from '../../lib/anchor'
import { backgroundClass } from '../../lib/background'

interface Props {
  block: HighlightsBlock
  /** Locale context for resolving an internal href — from core/BlockRenderer.astro. */
  locale?: string
  defaultLocale?: string
  pathIndex?: Record<string, Record<string, string>>
}

const { block, locale, defaultLocale, pathIndex } = Astro.props
const hrefCtx = locale && defaultLocale ? { locale, defaultLocale, pathIndex } : undefined
const { anchor_id, heading_icon, eyebrow, heading, intro, categories = [], links = [], footnote, background } = block.data

const sectionId = sectionAnchorId(anchor_id)

const groups = categories.filter((c) => c.title || (c.items ?? []).length > 0)
const linkRows = links.filter((link) => link.label && link.href)
---

<section id={sectionId} class:list={['section-highlights section-band py-16', backgroundClass(background)]}>
  <div class="highlights-inner">
    <SectionHeader headingIcon={heading_icon} {eyebrow} {heading} {intro} />

    {
      groups.map((category) => (
        <div class="mb-10 last:mb-0">
          {(category.title || category.note) && (
            <div class="flex items-baseline justify-between gap-4 border-b border-border pb-2 mb-4">
              {category.title && <h3 class="font-bold text-[22px] leading-[1.3]">{category.title}</h3>}
              {category.note && <p class="text-[14px] text-text-secondary">{category.note}</p>}
            </div>
          )}
          {(category.items ?? []).length > 0 && (
            <ul class="list-none p-0 m-0 flex flex-col gap-3">
              {(category.items ?? []).map((item) => (
                <li class="flex items-baseline justify-between gap-4">
                  <div>
                    {item.name && <p class="font-semibold text-[17px] leading-[1.4]">{item.name}</p>}
                    {item.description && (
                      <p class="text-[15px] text-text-secondary leading-[1.6]">{item.description}</p>
                    )}
                  </div>
                  {item.price && <p class="font-semibold text-[17px] whitespace-nowrap">{item.price}</p>}
                </li>
              ))}
            </ul>
          )}
        </div>
      ))
    }

    {
      linkRows.length > 0 && (
        <div class="flex flex-wrap justify-center gap-4 mt-10">
          {linkRows.map((link) => (
            <a href={hrefOf(link.href, hrefCtx)} class="link-inline text-[16px]">
              {link.label}
            </a>
          ))}
        </div>
      )
    }

    {footnote && <p class="text-center text-[14px] text-text-secondary leading-[1.6] mt-8">{footnote}</p>}
  </div>
</section>
