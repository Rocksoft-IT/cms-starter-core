---
import type { CtaBannerBlock } from '../../types/blocks'
interface Props {
  block: CtaBannerBlock
}
const { block } = Astro.props
const { eyebrow, heading, body, badges = [], ctas = [] } = block.data
---

<section class="section-cta">
  <div class="cta-inner">
    <div class="cta-content">
      {
        badges.length > 0 && (
          <div class="cta-badges">
            {badges.map((badge) => badge.label && <span class="cta-badge">{badge.label}</span>)}
          </div>
        )
      }
      {eyebrow && <p class="font-suse text-[20px] leading-[24px] uppercase font-normal text-white">{eyebrow}</p>}
      {heading && <h2 class="font-suse font-bold text-[24px] leading-[1] text-white">{heading}</h2>}
      {body && <p class="font-montserrat text-[18px] text-gray-300 leading-[1.7]">{body}</p>}
    </div>
    {
      ctas.length > 0 && (
        <div class="flex flex-wrap gap-4 justify-center mt-8">
          {ctas.map((cta) => (
            <a href={cta.href} class="btn-white">
              {cta.label}
            </a>
          ))}
        </div>
      )
    }
  </div>
</section>

<style>
  .cta-content {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    text-align: center;
  }

  /* Optional highlight tags (`badges` repeater). Brand-neutral pill that reads on the dark
     CTA background; a gentle pulse draws the eye. Self-contained keyframe so it never depends
     on a project stylesheet being loaded. */
  .cta-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    justify-content: center;
  }
  .cta-badge {
    display: inline-block;
    padding: 0.3rem 0.7rem;
    border: 1px solid rgba(255, 255, 255, 0.4);
    border-radius: 9999px;
    background: rgba(255, 255, 255, 0.12);
    color: #fff;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    animation: cta-badge-pulse 2.4s ease-in-out infinite;
  }
  @keyframes cta-badge-pulse {
    0%,
    100% {
      opacity: 1;
      transform: scale(1);
    }
    50% {
      opacity: 0.75;
      transform: scale(1.04);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .cta-badge {
      animation: none;
    }
  }
</style>
