---
import type { CtaBannerBlock } from '../../types/blocks'
import { href as hrefOf } from '../../lib/href'
import { hrefContextFor } from '../pathIndex'
import { usableCtas } from '../../lib/ctas'
import { sectionAnchorId } from '../../lib/anchor'
import { backgroundClass } from '../../lib/background'
import { revealClass, revealsOnScroll } from '../../lib/reveal'
import SectionReveal from '../SectionReveal.astro'
import HeadingIcon from '../HeadingIcon.astro'
interface Props {
  /** The locale tree this block is being built into, from core/BlockRenderer.astro. Resolving an
   *  editor-typed href needs it; everything else about the context is build-scoped (core/pathIndex.ts). */
  locale?: string
  block: CtaBannerBlock
}
const { block, locale } = Astro.props
// Editor-typed hrefs: on a translated tree they carry the DEFAULT locale’s address, because that is
// the only one the panel shows while editing any locale’s copy (lib/href.ts). `undefined` on the
// default tree, which is what makes this a no-op there.
const hrefCtx = await hrefContextFor(locale)
// `intro`, not `body`: this block's standfirst was renamed onto the shared `intro` universal part
// (dashboard#1977). A NAME change only — the field was already a textarea, and `cta-body` below
// keeps its class, because the element is this banner's own and the site layer styles it.
const { heading_icon, eyebrow, heading, intro, badges = [], anchor_id, background, reveal } = block.data

// `?? 'dark'`, where the other seven banded blocks fall through to no modifier at all. This block
// was black before it had the field (#1933), and every banner already published carries no
// `background` key — so the absent case has to keep meaning the black band, or the next build
// turns every existing client's closing CTA into a page-ground one. `default` stays reachable; an
// editor picking it is saying so deliberately.
const bandClass = backgroundClass(background ?? 'dark')
// The shared `reveal` select (#1985) — `on` marks the section for the observer in
// core/SectionReveal.astro, which is the only thing that ever hides it. See lib/reveal.ts.
const revealModifier = revealClass(reveal)

// Half-filled rows dropped rather than drawn as an empty link — see lib/ctas.ts.
const ctas = usableCtas(block.data.ctas)

// Deep-link target, so a header CTA or in-page link can point at this banner (#1474). See lib/anchor.ts.
const sectionId = sectionAnchorId(anchor_id)
---

<section class:list={['section-cta section-band section-reveal', bandClass, revealModifier]} id={sectionId}>
  <div class="cta-inner">
    <div class="cta-content">
      {
        badges.length > 0 && (
          <div class="cta-badges">
            {badges.map((badge) => badge.label && <span class="cta-badge">{badge.label}</span>)}
          </div>
        )
      }
      <HeadingIcon svg={heading_icon} />
      {eyebrow && <p class="cta-eyebrow">{eyebrow}</p>}
      {heading && <h2 class="cta-heading">{heading}</h2>}
      {intro && <p class="cta-body">{intro}</p>}
    </div>
    {
      ctas.length > 0 && (
        <div class="cta-actions">
          {ctas.map((cta) => (
            <a href={hrefOf(cta.href, hrefCtx)} class="btn-white">
              {cta.label}
            </a>
          ))}
        </div>
      )
    }
  </div>
  {
    /* The observer, once per page and only for a section that asked to fade in (#1985). See core/SectionReveal.astro. */
  }
  {revealsOnScroll(reveal) && <SectionReveal />}
</section>
