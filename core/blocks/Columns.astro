---
// Core columns block — renders nested blocks side by side, with track widths coming from the
// block's `columns_layout` shares.
//
// The container sits on the grid, not on the <section>: the section stays full-bleed so a site can
// give it a background, and the measure is one shortcut (`columns-grid`) a site can remap. Track
// sizing rides the inline `--cols` custom property, read by an arbitrary-value utility in that same
// shortcut — so this component needs no CSS of its own at all. The block's other two settings ride
// the same channel, for the same reason: a custom property has no specificity to lose.
import type { ColumnsBlock } from '../../types/blocks'
import { parseLayoutShares, shareAt } from '../../lib/layout-shares'
import BlockRenderer from '../BlockRenderer.astro'
import { sectionAnchorId } from '../../lib/anchor'
import { backgroundClass } from '../../lib/background'

interface Props {
  block: ColumnsBlock
  /** Forwarded to the nested blocks — a gallery inside this one must not lose the locale on the
   *  way down (core/BlockRenderer.astro). */
  locale?: string
}

const { block, locale } = Astro.props

const sectionId = sectionAnchorId(block.data.anchor_id)

// Track sizing: each column's `width` numerator, falling back to its slot's `layout` share (see
// src/lib/layout-shares.ts for the width/layout contract). Falling back BEFORE dropping empties
// keeps each surviving column aligned to its original slot.
const layoutShares = parseLayoutShares(block.data.layout)

const columns = (block.data.columns ?? [])
  .map((col, i) => ({ blocks: col.blocks ?? [], share: shareAt(col.width, layoutShares, i) }))
  // The live API unconditionally drops an empty column at resolve time (and `drop_when_empty` drops
  // the whole block once EVERY column is empty) — mirror the per-column drop here so a stray empty
  // column in a hand-authored payload doesn't claim a track and skew the row. A lone surviving column
  // is a single `fr` track, so it naturally reclaims the whole row.
  .filter((col) => col.blocks.length > 0)

// On mobile the grid auto-stacks to one column, in authoring order (see the `columns-grid` shortcut).
const template = columns.map((col) => `${col.share}fr`).join(' ')

// `width: 'prose'` narrows the row to the text measure. Set as a property rather than by swapping
// `container-global` for `container-prose`: both expand to a `max-w-[…]` utility, so composing them
// on one element would leave the winner to the order Uno happens to emit them in.
const measure = block.data.width === 'prose' ? 'var(--layout-container-prose)' : undefined

// `mobile_reverse` flips which column reads first ONLY while the row is stacked. Done with `order`
// under the `max-md:` variant rather than by reversing the markup or switching the container to
// `flex-col-reverse`: the DOM order stays as authored (so reading and focus order do too), the
// desktop row is untouched because `order` is never applied above `md`, and it generalises to a
// three- or four-column preset instead of assuming two.
const reverse = block.data.mobile_reverse === true
---

<section id={sectionId} class:list={['section-columns section-band', backgroundClass(block.data.background)]}>
  <div
    class:list={['columns-grid', reverse && 'columns-reverse-mobile']}
    style={[`--cols: ${template};`, measure && `--columns-measure: ${measure};`].filter(Boolean).join(' ')}
  >
    {
      columns.map((col, i) => (
        <div class="columns-col" style={reverse ? `--col-order: ${columns.length - i}` : undefined}>
          <BlockRenderer blocks={col.blocks} {locale} />
        </div>
      ))
    }
  </div>
</section>
