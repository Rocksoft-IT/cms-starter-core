---
// Core FAQ block — two layouts over one content shape.
//
// `accordion` (the default, and what every block authored before the field gets) is an
// accessible, single-open accordion. It uses native <details name=…>, whose shared `name` makes
// the items mutually exclusive (opening one closes the others) with NO JavaScript; it stays
// keyboard-operable and announced by screen readers out of the box. A browser without
// exclusive-<details> support degrades to allowing several open at once — the content is always
// reachable either way.
//
// `list` drops the disclosure entirely: question as a heading, answer under it, nothing to
// click. For a short FAQ that reads as page copy rather than a lookup table — and for the
// reader/print/find-in-page views, where collapsed answers are simply absent.
//
// `open_first` (accordion only) ships the first item already expanded, so the page arrives
// showing what an answer looks like instead of a row of closed bars. Because the group is
// exclusive, opening any other item closes it again — no special handling needed.
//
// Every visual value lives in the `faq-*` shortcuts (core/uno.core.ts), which a site redefines in
// its src/uno.ts — colors resolve as brand theme colors, so a client palette rethemes the whole
// accordion at build time. What remains below is only what no utility can express: hiding the
// native ::marker, the <details open> state selectors, and the answer's reveal animation.
import type { FaqBlock } from '../../types/blocks'
import RichText from '../RichText.astro'
import { sectionAnchorId } from '../../lib/anchor'
import { backgroundClass } from '../../lib/background'
import { href as hrefOf } from '../../lib/href'
import { usableCtas } from '../../lib/ctas'
import HeadingIcon from '../HeadingIcon.astro'
interface Props {
  block: FaqBlock
}
const { block } = Astro.props
const {
  anchor_id,
  heading_icon,
  eyebrow,
  heading,
  intro,
  layout,
  open_first,
  ctas,
  items = [],
  background,
} = block.data

// Deep-link target (#1416) — not to be confused with `groupName` below, which names the
// accordion's exclusive group: that one is derived from the heading and must exist on every
// block, this one is the editor's own and may be unset.
const sectionId = sectionAnchorId(anchor_id)

// Anything but 'list' renders the accordion (see the header note on the default).
const isList = layout === 'list'

// The optional inline CTA, held to ONE by the panel (`max => 1`, dashboard#1959). It used to be a
// `cta_label` + `cta_href` pair with its own "needs both halves" gate; `usableCtas()` is that same
// rule, shared with every block fed by `$ctaList` — a label with nowhere to go, or a bare URL with
// no label, renders nothing rather than a broken link. See lib/ctas.ts.
const cta = usableCtas(ctas)[0]
// An absolute http(s) target leaves the site, so it opens in a new tab and gets the external glyph.
// A path stays in place, plain.
const ctaExternal = /^https?:\/\//.test(cta?.href ?? '')

// Exclusive-accordion group name (the list layout has no groups). Derived from the heading
// (deterministic — no build-to-build churn) so two FAQ blocks with different headings on one page
// form independent groups; blocks without a heading share one group, a benign edge case.
const slug = (heading ?? 'section')
  .toLowerCase()
  .replace(/[^a-z0-9]+/g, '-')
  .replace(/^-+|-+$/g, '')
  .slice(0, 32)
const groupName = `faq-${slug || 'section'}`
---

<section class:list={['section-faq section-band', backgroundClass(background)]} id={sectionId}>
  <div class="faq-inner">
    {
      (heading_icon || eyebrow || heading || intro || cta) && (
        <header class="faq-header">
          <HeadingIcon svg={heading_icon} />
          {eyebrow && <p class="faq-eyebrow">{eyebrow}</p>}
          <div class:list={[cta && 'faq-header-row']}>
            <div>
              {heading && <h2 class="faq-heading">{heading}</h2>}
              {intro && <p class="faq-intro">{intro}</p>}
            </div>
            {cta && (
              <a
                class="faq-action surface-light"
                href={hrefOf(cta.href)}
                target={ctaExternal ? '_blank' : undefined}
                rel={ctaExternal ? 'noopener noreferrer' : undefined}
              >
                {cta.label}
                {ctaExternal && (
                  <svg
                    viewBox="0 0 24 24"
                    width="15"
                    height="15"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="M7 17 17 7M8 7h9v9" />
                  </svg>
                )}
              </a>
            )}
          </div>
        </header>
      )
    }
    <ul class="faq-list" role="list">
      {
        items.map((item, index) =>
          isList ? (
            <li class="faq-item faq-item-static surface-light">
              <h3 class="faq-question">{item.question}</h3>
              <RichText class="faq-answer" html={item.answer} />
            </li>
          ) : (
            <li>
              <details name={groupName} class="faq-item surface-light" open={index === 0 && open_first}>
                <summary class="faq-summary">
                  <span class="faq-question">{item.question}</span>
                  <span class="faq-chevron" aria-hidden="true">
                    <svg
                      viewBox="0 0 24 24"
                      width="18"
                      height="18"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.2"
                    >
                      <path d="M6 9l6 6 6-6" />
                    </svg>
                  </span>
                </summary>
                <div class="faq-answer-wrap">
                  <RichText class="faq-answer" html={item.answer} />
                </div>
              </details>
            </li>
          ),
        )
      }
    </ul>
  </div>
</section>

<style>
  /* `@layer core` makes these the weakest declarations on the page, so a site's own CSS — and
     every Uno utility, including the ones from a redefined faq-* shortcut — outranks them without
     !important, at any specificity. */
  @layer core {
    /* Hide the native disclosure triangle across engines. No utility targets ::marker. */
    .faq-summary::-webkit-details-marker {
      display: none;
    }
    .faq-summary::marker {
      content: '';
    }

    /* Open state. Parent-state selectors on <details>, so they cannot live on the child's class. */
    details[open] > .faq-summary {
      /* Fallback like every other core block: the var is defined at :root by Layout, but a
         consumer that renders this block outside that layout would otherwise get no background. */
      background: var(--color-surface-alt, #f5f6f8);
    }
    details[open] .faq-chevron {
      transform: rotate(180deg);
    }

    /* The answer's reveal. A keyframe animation has no utility equivalent; the reduced-motion
       opt-out rides `motion-reduce:animate-none` on the shortcut. */
    .faq-answer-wrap {
      animation: faq-dropIn 0.22s ease both;
    }
    @keyframes faq-dropIn {
      from {
        opacity: 0;
        transform: translateY(-6px);
      }
      to {
        opacity: 1;
        transform: none;
      }
    }
  }
</style>
