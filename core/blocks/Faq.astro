---
// Core FAQ block — an accessible, single-open accordion. Uses native <details name=…>, whose
// shared `name` makes the items mutually exclusive (opening one closes the others) with NO
// JavaScript; it stays keyboard-operable and announced by screen readers out of the box. A
// browser without exclusive-<details> support degrades to allowing several open at once — the
// content is always reachable either way.
//
// Every visual value lives in the `faq-*` shortcuts (core/uno.core.ts), which a site redefines in
// its src/uno.ts — colors resolve as brand theme colors, so a client palette rethemes the whole
// accordion at build time. What remains below is only what no utility can express: hiding the
// native ::marker, the <details open> state selectors, and the answer's reveal animation.
import type { FaqBlock } from '../../types/blocks'
import RichText from '../RichText.astro'
interface Props {
  block: FaqBlock
}
const { block } = Astro.props
const { eyebrow, heading, intro, items = [] } = block.data

// Exclusive-accordion group name. Derived from the heading (deterministic — no build-to-build
// churn) so two FAQ blocks with different headings on one page form independent groups; blocks
// without a heading share one group, a benign edge case.
const slug = (heading ?? 'section')
  .toLowerCase()
  .replace(/[^a-z0-9]+/g, '-')
  .replace(/^-+|-+$/g, '')
  .slice(0, 32)
const groupName = `faq-${slug || 'section'}`
---

<section class="section-faq">
  <div class="faq-inner">
    {
      (eyebrow || heading || intro) && (
        <header class="faq-header">
          {eyebrow && <p class="faq-eyebrow">{eyebrow}</p>}
          {heading && <h2 class="faq-heading">{heading}</h2>}
          {intro && <p class="faq-intro">{intro}</p>}
        </header>
      )
    }
    <ul class="faq-list" role="list">
      {
        items.map((item) => (
          <li>
            <details name={groupName} class="faq-item">
              <summary class="faq-summary">
                <span class="faq-question">{item.question}</span>
                <span class="faq-chevron" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2">
                    <path d="M6 9l6 6 6-6" />
                  </svg>
                </span>
              </summary>
              <div class="faq-answer-wrap">
                <RichText class="faq-answer" html={item.answer} />
              </div>
            </details>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  /* `@layer core` makes these the weakest declarations on the page, so a site's own CSS — and
     every Uno utility, including the ones from a redefined faq-* shortcut — outranks them without
     !important, at any specificity. */
  @layer core {
    /* Hide the native disclosure triangle across engines. No utility targets ::marker. */
    .faq-summary::-webkit-details-marker {
      display: none;
    }
    .faq-summary::marker {
      content: '';
    }

    /* Open state. Parent-state selectors on <details>, so they cannot live on the child's class. */
    details[open] > .faq-summary {
      background: var(--color-surface-alt);
    }
    details[open] .faq-chevron {
      transform: rotate(180deg);
    }

    /* The answer's reveal. A keyframe animation has no utility equivalent; the reduced-motion
       opt-out rides `motion-reduce:animate-none` on the shortcut. */
    .faq-answer-wrap {
      animation: faq-dropIn 0.22s ease both;
    }
    @keyframes faq-dropIn {
      from {
        opacity: 0;
        transform: translateY(-6px);
      }
      to {
        opacity: 1;
        transform: none;
      }
    }
  }
</style>
