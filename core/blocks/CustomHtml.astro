---
import type { CustomHtmlBlock } from '../../types/blocks'
import { sectionAnchorId } from '../../lib/anchor'
import { backgroundClass } from '../../lib/background'
import { hrefContextFor } from '../pathIndex'
import { localizeHtmlHrefs } from '../../lib/html-hrefs'

interface Props {
  /** The locale tree this block is being built into, from core/BlockRenderer.astro. Resolving an
   *  editor-typed href needs it; everything else about the context is build-scoped (core/pathIndex.ts). */
  locale?: string
  block: CustomHtmlBlock
}
const { block, locale } = Astro.props
const { anchor_id, html, full_width, background } = block.data

// The escape hatch is also the worst case for a hand-typed internal link: no field, no schema, no
// warning — just markup, and an editor who only ever saw the default locale’s addresses. Only
// `<a>` hrefs are touched, and only on a translated tree; everything else ships verbatim, which is
// this field’s whole contract (lib/html-hrefs.ts).
const localized = localizeHtmlHrefs(html, await hrefContextFor(locale))

const sectionId = sectionAnchorId(anchor_id)
---

<section id={sectionId} class:list={['section-custom-html section-band py-8', backgroundClass(background)]}>
  {
    /* set:html is intentionally unsanitized — admin is trusted and scripts must be preserved.
      Projects with untrusted editors can opt into sanitization using the sanitize-html dependency. */
  }
  {full_width ? <div set:html={localized} /> : <div class="custom-html-inner" set:html={localized} />}
</section>

{
  /* A <script> that arrives via `set:html` (innerHTML under the hood) carries the HTML spec's
     "already started" flag and never executes its own JS — confirmed live against a real embed
     (a Pipedrive web form): the script's own network request still fires, which is what makes
     this look like a slow-loading widget rather than a script that silently never ran. Cloning
     each inert script into a freshly created node is what actually gets the browser to run it —
     the same technique `core/customCode.ts`'s `CUSTOM_CODE_ACTIVATOR_JS` already uses for
     site-wide snippets, applied here unconditionally: an editor pasting a `<script>` into this
     block clearly wants it to run, with no consent gate to wait on (unlike a site-wide snippet,
     which IS subject to cookie-consent rules — this field has no such category).
     Astro deduplicates identical inline `<script>` tags across every instance of this component
     on one page, so this runs exactly once per page regardless of how many `custom_html` blocks
     it holds, and the query scans all of them in that one pass — scoped to `.section-custom-html`
     (present on both the `full_width` and default wrapper) so it never touches an unrelated
     script elsewhere on the page. */
}
<script>
  document.querySelectorAll('.section-custom-html script').forEach((old) => {
    const fresh = document.createElement('script')
    for (const { name, value } of old.attributes) fresh.setAttribute(name, value)
    fresh.text = old.textContent ?? ''
    old.replaceWith(fresh)
  })
</script>
