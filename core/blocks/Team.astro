---
// Core team block. Renders a responsive grid of member cards (photo + name + role) under an
// optional eyebrow/heading. Every field is optional and degrades gracefully:
//  - a member with no photo shows a neutral initial placeholder instead of a broken <img>;
//  - the <img> `alt` is derived from the member name (empty alt for the decorative placeholder);
//  - `anchor_id` becomes the section `id` so the block is a deep-link / scroll target. Whitespace
//    is collapsed to hyphens so the value is a usable URL fragment; Astro escapes the attribute.
import type { TeamBlock } from '../../types/blocks'
import { sectionAnchorId } from '../../lib/anchor'
import { backgroundClass } from '../../lib/background'
import { IMAGE_SIZES, responsiveImageAttrs } from '../../lib/image'
import SectionHeader from '../SectionHeader.astro'

interface Props {
  block: TeamBlock
}

const { block } = Astro.props
const { anchor_id, eyebrow, heading, members = [], background } = block.data

const sectionId = sectionAnchorId(anchor_id)

// A member is worth a card as long as it carries anything to show.
const cards = members.filter((m) => m.name || m.role || m.photo)

function initial(name?: string) {
  return name?.trim().charAt(0).toUpperCase() || ''
}
---

<section class:list={['section-team section-band', backgroundClass(background)]} id={sectionId}>
  <div class="team-inner">
    <SectionHeader {eyebrow} {heading} />

    {
      cards.length > 0 && (
        <ul class="team-grid">
          {cards.map((member) => (
            <li class="team-card">
              <div class="team-photo surface-light">
                {member.photo ? (
                  <img
                    src={member.photo}
                    alt={member.name || ''}
                    loading="lazy"
                    {...responsiveImageAttrs(member.photo_meta, IMAGE_SIZES.gridTile)}
                  />
                ) : (
                  <span class="team-photo-placeholder" aria-hidden="true">
                    {initial(member.name)}
                  </span>
                )}
              </div>
              {member.name && <p class="team-name">{member.name}</p>}
              {member.role && <p class="team-role">{member.role}</p>}
            </li>
          ))}
        </ul>
      )
    }
  </div>
</section>
