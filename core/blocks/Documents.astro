---
// Documents block (`documents`): a titled list of downloadable files from the CMS Files library.
// The API resolves each stored file id into `data.files` = [{ id, name, description, url, size }]
// in the editor-chosen order (packages/cms-core PagePayload::resolveFileRecord). Pure renderer:
// a section header (an optional glyph beside the title) over a list of rows, each a link to the
// document — document icon on the left, name in the middle, download icon on the right.
//
// A row with no `url` is dropped (a stale/empty file reference can't link anywhere); if that
// leaves no linkable file, the whole block renders nothing — a heading with no downloads is
// pointless, so it is gated on rows, not on the heading (contract: empty list -> nothing).
import type { DocumentsBlock } from '../../types/blocks'
import { ICON_PATHS, iconPath } from '../../lib/icons'

interface Props {
  block: DocumentsBlock
}

const { block } = Astro.props
const { heading, icon, files = [] } = block.data

// Only files that resolved to a real URL can render as a link.
const rows = files.filter((f) => typeof f.url === 'string' && f.url !== '')
const hasHeading = typeof heading === 'string' && heading.trim() !== ''

// The fixed heading-glyph set (matches the block's `icon` select options). Each is an outline
const headingIcon = iconPath(icon)

// The document glyph shown on the left of every row, and the download glyph on the right.
const DOC_ICON = ICON_PATHS.document
const DOWNLOAD_ICON = ICON_PATHS.download
---

{
  rows.length > 0 && (
    <section class="documents py-16">
      <div class="container-global">
        {hasHeading && (
          <div class="mb-8 flex items-center gap-3">
            {headingIcon && (
              <svg
                class="h-7 w-7 shrink-0 text-primary"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d={headingIcon} />
              </svg>
            )}
            <h2 class="section-heading">{heading}</h2>
          </div>
        )}

        {rows.length > 0 && (
          <ul class="m-0 flex list-none flex-col gap-3 p-0">
            {rows.map((file) => {
              const label = typeof file.name === 'string' && file.name.trim() !== '' ? file.name : 'Document'
              return (
                <li>
                  <a
                    href={file.url!}
                    target="_blank"
                    rel="noopener noreferrer"
                    download
                    class="flex items-center gap-4 rounded-[12px] border border-gray-200 bg-section-bg p-4 transition-colors hover:border-primary"
                    aria-label={label}
                  >
                    <svg
                      class="h-6 w-6 shrink-0 text-text-secondary"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <path d={DOC_ICON} />
                    </svg>
                    <span class="min-w-0 flex-1 truncate font-semibold text-text-primary">{label}</span>
                    <svg
                      class="h-5 w-5 shrink-0 text-primary"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <path d={DOWNLOAD_ICON} />
                    </svg>
                  </a>
                </li>
              )
            })}
          </ul>
        )}
      </div>
    </section>
  )
}
