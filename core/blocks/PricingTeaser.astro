---
// Core pricing-teaser block: a short, centered pitch (eyebrow/heading/body) over a small grid
// of pricing cards (title + optional bullets + price line + CTA), with an optional footer
// link. The lightweight companion to `pricing_table` — cards are authored inline in the
// page builder, not resolved from the plans collection.
import type { PricingTeaserBlock } from '../../types/blocks'
import SectionHeader from '../SectionHeader.astro'
import { href as hrefOf } from '../../lib/href'
import { alignClass } from '../../lib/align'
import { backgroundClass } from '../../lib/background'
import { sectionAnchorId } from '../../lib/anchor'

interface Props {
  block: PricingTeaserBlock
  /** Locale context for resolving an internal href — from core/BlockRenderer.astro. */
  locale?: string
  defaultLocale?: string
  pathIndex?: Record<string, Record<string, string>>
}

const { block, locale, defaultLocale, pathIndex } = Astro.props
const hrefCtx = locale && defaultLocale ? { locale, defaultLocale, pathIndex } : undefined
// `intro`, not `body`: this block's standfirst was renamed onto the shared `intro` universal part
// (dashboard#1977). It was always the `intro` PROP — the header below used to receive it as
// `intro={body}` — so the indirection is what went, not a field.
const { anchor_id, heading_icon, eyebrow, heading, intro, align, background, cards = [], footer_label, footer_href } = block.data

const sectionId = sectionAnchorId(anchor_id)

// The shared `background` select — a band modifier the styling layer paints (#1498).
// See lib/background.ts.
const bandClass = backgroundClass(background)
// The shared `align` select (#1643) — the header does the aligning, this is the site hook.
// See lib/align.ts.
const alignModifier = alignClass(align)

// `bullets` is a plain textarea: one bullet per non-empty line.
const bulletLines = (bullets?: string) =>
  (bullets ?? '')
    .split('\n')
    .map((line) => line.trim())
    .filter(Boolean)
---

<section id={sectionId} class:list={['section-pricing-teaser section-band py-16', bandClass, alignModifier]}>
  <div class="pricing-teaser-inner">
    <SectionHeader headingIcon={heading_icon} {eyebrow} {heading} {intro} {align} />

    {
      cards.length > 0 && (
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-[840px] mx-auto">
          {cards.map((card) => {
            const lines = bulletLines(card.bullets)
            return (
              <div class="surface-light border border-border rounded-[16px] p-8 flex flex-col bg-white">
                <div class="flex flex-col gap-2 mb-4">
                  {card.eyebrow && (
                    <p class="text-[16px] leading-[1.2] uppercase text-text-secondary">{card.eyebrow}</p>
                  )}
                  {card.title && <h3 class="font-bold text-[24px] leading-[1.2]">{card.title}</h3>}
                </div>
                {lines.length > 0 && (
                  <ul class="list-none p-0 m-0 flex flex-col gap-2 mb-4">
                    {lines.map((line) => (
                      <li class="text-[16px] leading-[1.7] font-semibold">{line}</li>
                    ))}
                  </ul>
                )}
                {card.price_label && (
                  <p class="text-[16px] leading-[1.7] text-text-secondary mb-4">{card.price_label}</p>
                )}
                {card.cta_label && card.cta_href && (
                  <a href={hrefOf(card.cta_href, hrefCtx)} class="btn-primary justify-center mt-auto">
                    {card.cta_label}
                  </a>
                )}
              </div>
            )
          })}
        </div>
      )
    }

    {
      footer_label && footer_href && (
        <p class="text-center mt-8 text-[16px]">
          <a href={hrefOf(footer_href, hrefCtx)} class="link-inline">
            {footer_label}
          </a>
        </p>
      )
    }
  </div>
</section>
