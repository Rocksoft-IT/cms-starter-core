---
// Promo split — a two-column promo panel: brand-colored panel (bg-secondary token) with an
// eyebrow chip, heading, body copy and one pill CTA on one side, a photo bleeding to the
// panel edge on the other; `reverse` puts the photo left (md+). Scaffolded by
// `pnpm cms:scaffold-block promo_split`, styled to the smbp home design (export_smbp_preview,
// "ODK" section) — all colors via brand tokens, so any site rethemes it from its palette.
// The 2-col split only applies when an image is set; a copy-only panel stays single-column.
import type { PromoSplitBlock } from '../../types/blocks'
import { href as hrefOf } from '../../lib/href'
import { headingTag } from '../../lib/headingLevel'
import { IMAGE_SIZES, responsiveImageAttrs } from '../../lib/image'
import { sectionAnchorId } from '../../lib/anchor'
import { backgroundClass } from '../../lib/background'

interface Props {
  block: PromoSplitBlock
}

const { block } = Astro.props
const { anchor_id, eyebrow, heading, heading_level, body, cta_label, cta_href, src, src_meta, alt = '', reverse, background } = block.data

const sectionId = sectionAnchorId(anchor_id)
// Capitalized so Astro treats it as a dynamic tag rather than a literal <headingtag> element.
const Heading = headingTag(heading_level)
---

<section id={sectionId} class:list={['section-promo-split section-band', backgroundClass(background)]}>
  <div class="promo-split-inner">
    <div class:list={['promo-split-panel', src && 'md:grid-cols-[minmax(0,1.05fr)_minmax(0,0.95fr)]']}>
      <div class="promo-split-content">
        {eyebrow && <span class="promo-split-eyebrow">{eyebrow}</span>}
        {heading && <Heading class="promo-split-heading">{heading}</Heading>}
        {body && <p class="promo-split-body">{body}</p>}
        {
          cta_label && cta_href && (
            <a class="promo-split-cta" href={hrefOf(cta_href)}>
              {cta_label}
              <svg
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M5 12h14M13 6l6 6-6 6" />
              </svg>
            </a>
          )
        }
      </div>
      {
        src && (
          <div class:list={['promo-split-media', reverse && 'md:order-first']}>
            <img
              class="promo-split-image"
              src={src}
              alt={alt}
              loading="lazy"
              {...responsiveImageAttrs(src_meta, IMAGE_SIZES.halfPanel)}
            />
          </div>
        )
      }
    </div>
  </div>
</section>
