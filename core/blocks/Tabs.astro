---
// Core Tabs block (#894) — an accessible tab strip. Each tab holds its own blocks (rendered
// recursively through BlockRenderer, so a `columns` layout inside a tab Just Works). Tab and
// panel element ids come from the server-derived per-locale `anchor` (slug of the tab name),
// so deep-linking (`…#anchor`) and the ARIA wiring are consistent with the translated name.
//
// Progressive enhancement: the FIRST tab's panel is shown server-side (CSS), so content is
// visible with no JavaScript; a tiny no-framework script (below) enables switching + keyboard
// navigation. Colours/fonts come from brand CSS vars, so a client palette rethemes it at build.
import type { TabsBlock } from '../../types/blocks'
import BlockRenderer from '../BlockRenderer.astro'
import { sectionAnchorId } from '../../lib/anchor'
import { backgroundClass } from '../../lib/background'

interface Props {
  block: TabsBlock
  /** Forwarded to the nested blocks — a gallery inside this one must not lose the locale on the
   *  way down (core/BlockRenderer.astro). */
  locale?: string
}

const { block, locale } = Astro.props

const sectionId = sectionAnchorId(block.data.anchor_id)

// Keep only real tabs (a named tab, or one with content). `anchor` is server-derived; fall back
// to the index so ids stay unique even on a hand-authored payload that omitted it.
const tabs = (block.data.tabs ?? [])
  .map((t, i) => ({ name: t.name ?? '', anchor: t.anchor || `tab-${i + 1}`, blocks: t.blocks ?? [] }))
  .filter((t) => t.name !== '' || t.blocks.length > 0)

// A group id unique to this block instance (multiple tabs blocks can share a page).
const gid =
  tabs
    .map((t) => t.anchor)
    .join('-')
    .slice(0, 40) || 'tabs'
---

{
  tabs.length > 0 && (
    <section
      id={sectionId}
      class:list={['section-tabs section-band', backgroundClass(block.data.background)]}
      data-tabs
    >
      <div class="tabs-inner">
        <div class="tablist" role="tablist">
          {tabs.map((t, i) => (
            <button
              type="button"
              role="tab"
              id={`tab-${gid}-${t.anchor}`}
              class="tab"
              aria-controls={`panel-${gid}-${t.anchor}`}
              aria-selected={i === 0 ? 'true' : 'false'}
              tabindex={i === 0 ? 0 : -1}
            >
              {t.name || `Tab ${i + 1}`}
            </button>
          ))}
        </div>
        {tabs.map((t, i) => (
          <div
            role="tabpanel"
            id={`panel-${gid}-${t.anchor}`}
            class="tabpanel"
            aria-labelledby={`tab-${gid}-${t.anchor}`}
            hidden={i !== 0}
          >
            <BlockRenderer blocks={t.blocks} {locale} />
          </div>
        ))}
      </div>
    </section>
  )
}

<script>
  // No-framework tab switching + roving-tabindex keyboard nav. Wires every tabs block on the
  // page; safe if the script loads before/after hydration since it reads the DOM directly.
  function initTabs(root: HTMLElement) {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[role="tab"]'))
    const panels = tabs.map((t) => document.getElementById(t.getAttribute('aria-controls') || ''))

    function select(index: number, focus = true) {
      tabs.forEach((tab, i) => {
        const selected = i === index
        tab.setAttribute('aria-selected', selected ? 'true' : 'false')
        tab.tabIndex = selected ? 0 : -1
        const panel = panels[i]
        if (panel) panel.hidden = !selected
      })
      if (focus) tabs[index]?.focus()
    }

    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(i, false))
      tab.addEventListener('keydown', (e) => {
        const last = tabs.length - 1
        if (e.key === 'ArrowRight' || e.key === 'ArrowDown') select(i === last ? 0 : i + 1)
        else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') select(i === 0 ? last : i - 1)
        else if (e.key === 'Home') select(0)
        else if (e.key === 'End') select(last)
        else return
        e.preventDefault()
      })
    })
  }

  document.querySelectorAll<HTMLElement>('[data-tabs]').forEach(initTabs)
</script>
