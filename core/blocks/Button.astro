---
import type { ButtonBlock } from '../../types/blocks'
import { href as hrefOf } from '../../lib/href'
import { hrefContextFor } from '../pathIndex'

interface Props {
  /** The locale tree this block is being built into, from core/BlockRenderer.astro. Resolving an
   *  editor-typed href needs it; everything else about the context is build-scoped (core/pathIndex.ts). */
  locale?: string
  block: ButtonBlock
}

const { block, locale } = Astro.props
// Editor-typed hrefs: on a translated tree they carry the DEFAULT locale’s address, because that is
// the only one the panel shows while editing any locale’s copy (lib/href.ts). `undefined` on the
// default tree, which is what makes this a no-op there.
const hrefCtx = await hrefContextFor(locale)
const { label, href, style } = block.data

// Block-level style vs the brand-level default (CMS Branding, dashboard PR #632):
// an explicit `outline` on the block always renders outline; `primary` (or no style)
// picks the primary button *as the brand renders it* — .btn-primary is flipped to the
// outline look by global.css when <html data-btn-primary="outline"> (see Layout.astro).
// Keep ButtonGroup.astro's mapping identical to this one.
---

<div class="section-buttons">
  <a href={hrefOf(href, hrefCtx)} class={style === 'outline' ? 'btn-outline' : 'btn-primary'}>{label}</a>
</div>
