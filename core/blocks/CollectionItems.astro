// Core `collection_items` block — a placeholder, not content (dashboard #2335). It marks where a
// collection landing's item list renders among the blocks; the LIST is the landing's own to render,
// via the `collection_items` slot it hands `BlockRenderer` (see `core/placeholders.ts`). This
// component is what the placeholder renders when the page type passed no such slot — nothing — so
// a site that has not adopted the slot keeps its current layout and still registers the type.
import type { CollectionItemsBlock } from '../../types/blocks'

interface Props {
  block: CollectionItemsBlock
}
