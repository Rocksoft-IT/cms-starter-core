---
import type { FeaturesBlock } from '../../types/blocks'
import RichText from '../RichText.astro'
import SectionHeader from '../SectionHeader.astro'
interface Props {
  block: FeaturesBlock
}
const { block } = Astro.props
const { eyebrow, heading, intro, steps = [] } = block.data
---

<section class="section-features relative">
  <div class="features-inner">
    <div class="features-component">
      <SectionHeader {eyebrow} {heading} {intro} />
      <div class="features-steps">
        {
          steps.map((step, i) => {
            const isEven = i % 2 === 1
            return (
              <div class={`features-card ${isEven ? 'features-card-bottom' : 'features-card-top'}`}>
                <div class="features-number-badge">
                  <span class="font-brand font-bold text-black text-[18px]">{step.number}</span>
                </div>
                <div class="features-card-content">
                  <h3 class="font-brand font-bold text-[24px] leading-[1]">{step.title}</h3>
                  <RichText class="text-[16px] text-text-secondary leading-[1.7] mt-2" html={step.description} />
                </div>
              </div>
            )
          })
        }
      </div>
    </div>
  </div>
</section>
