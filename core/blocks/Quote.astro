---
// Core pull-quote block. A prominent quotation with optional supporting image,
// attribution and a source link. Everything except the quote itself is optional and
// degrades gracefully: with no image the text spans the full width; with no headline/
// lede the block is just the quote + attribution; with no source link the citation is
// the plain attribution line.
//
// The `quote` field is CMS richtext, so it flows through RichText (which sanitizes) rather
// than being interpolated raw — matching every other richtext surface in the starter. RichText
// applies the class it is given to its own element, so `quote-text` styles it directly and this
// block needs no CSS of its own.
import type { QuoteBlock } from '../../types/blocks'
import RichText from '../RichText.astro'
import { href as hrefOf } from '../../lib/href'
import { hrefContextFor } from '../pathIndex'
import { IMAGE_SIZES, responsiveImageAttrs } from '../../lib/image'
import { sectionAnchorId } from '../../lib/anchor'
import { backgroundClass } from '../../lib/background'

interface Props {
  /** The locale tree this block is being built into, from core/BlockRenderer.astro. Resolving an
   *  editor-typed href needs it; everything else about the context is build-scoped (core/pathIndex.ts). */
  locale?: string
  block: QuoteBlock
}

const { block, locale } = Astro.props
// Editor-typed hrefs: on a translated tree they carry the DEFAULT locale’s address, because that is
// the only one the panel shows while editing any locale’s copy (lib/href.ts). `undefined` on the
// default tree, which is what makes this a no-op there.
const hrefCtx = await hrefContextFor(locale)
const {
  anchor_id,
  source_tag,
  headline,
  lede,
  quote,
  attribution,
  source_link_label,
  source_link_href,
  image,
  image_meta,
  alt = '',
  background,
} = block.data

const sectionId = sectionAnchorId(anchor_id)

// A source link needs an href; the label falls back to the href so a URL-only field still renders.
const hasSourceLink = Boolean(source_link_href)
const sourceLinkText = source_link_label || source_link_href
---

<section id={sectionId} class:list={['section-quote section-band', backgroundClass(background)]}>
  <div class:list={['quote-inner', { 'quote-has-image': image }]}>
    {
      image && (
        <figure class="quote-figure">
          <img
            src={image}
            alt={alt}
            class="quote-image"
            loading="lazy"
            {...responsiveImageAttrs(image_meta, IMAGE_SIZES.halfPanel)}
          />
        </figure>
      )
    }
    <div class="quote-body">
      {source_tag && <p class="quote-source-tag">{source_tag}</p>}
      {headline && <h2 class="quote-headline">{headline}</h2>}
      {lede && <p class="quote-lede">{lede}</p>}
      {
        quote && (
          <blockquote class="quote-mark">
            <RichText class="quote-text" html={quote} {locale} />
          </blockquote>
        )
      }
      {
        (attribution || hasSourceLink) && (
          <figcaption class="quote-cite">
            {attribution && <span class="quote-attribution">{attribution}</span>}
            {hasSourceLink && (
              <a class="quote-source-link" href={hrefOf(source_link_href, hrefCtx)}>
                {sourceLinkText}
              </a>
            )}
          </figcaption>
        )
      }
    </div>
  </div>
</section>
