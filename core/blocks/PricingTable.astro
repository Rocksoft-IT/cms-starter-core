---
// Core pricing_table block (ref block): the API resolves the referenced `plan` items into
// `plans`, or — when `billing_toggle` is set — folds them into `tabs` grouped by each plan's
// `billing_type` (the backend group_by resolver). One tab renders at a time; the buttons
// switch panels with a few lines of script scoped to this section. Plan cards render
// size_label chip → tier illustration → name → description → badge → price → fine print → CTA
// → collapsible feature list, every field optional.
//
// `width: 'wide'` swaps the page container for the one step past it — a four-card set does not
// fit the page measure without squeezing all four.
import type { PricingTableBlock } from '../../types/blocks'
import { sanitizeSvg } from '../../lib/sanitize'
import { sectionAnchorId } from '../../lib/anchor'
import RichText from '../RichText.astro'
import SectionHeader from '../SectionHeader.astro'
import { href as hrefOf } from '../../lib/href'
import { backgroundClass } from '../../lib/background'

interface Props {
  block: PricingTableBlock
}

const { block } = Astro.props
const { anchor_id, eyebrow, heading, body, background, width, billing_toggle, tabs, plans, tab_icons } = block.data

// Human labels for the backend's billing_type enum (mirrors config/cms.php select options).
const TAB_LABELS: Record<string, string> = {
  one_time: 'One-time',
  subscription: 'Subscription',
}

// Ungrouped payloads (billing_toggle off, or hand-authored fixtures) arrive as a flat
// `plans` list — normalize both shapes into a tab list so the template has one path.
const displayTabs = tabs ?? (plans ? [{ billing_type: '', plans }] : [])
const showTabs = !!billing_toggle && displayTabs.length > 1

const sectionId = sectionAnchorId(anchor_id)
const tabIcon = (billingType: string) => tab_icons?.find((icon) => icon.billing_type === billingType)?.icon_svg

// Prefix for the tab-button ↔ panel aria-controls wiring. Derived from the anchor when set;
// two anchor-less pricing tables on one page would collide — give them anchors in the CMS.
const idPrefix = sectionId ?? 'pricing-table'

// A literal lookup, not an interpolated class: UnoCSS extracts class names from source text,
// so `container-${width}` would generate no CSS at all (see docs/starter.md).
const containerClass = width === 'wide' ? 'container-wide' : 'container-global'

// The shared `background` select, on the same helper as the five other blocks that carry it
// (#1498). It used to be a local `background === 'dark'` ternary here, paired with a shortcut that
// read "dark" as the client-editable SECONDARY brand color — white text on a white band for a
// client whose secondary is light. See lib/background.ts.
const bandClass = backgroundClass(background)
---

<section id={sectionId} class:list={['section-pricing-table section-band py-20', bandClass]}>
  <div class={containerClass}>
    <SectionHeader {eyebrow} {heading} />

    {
      showTabs && (
        <div class="pricing-tabs flex justify-center gap-3 mb-10">
          {displayTabs.map((tab, i) => {
            const icon = tabIcon(tab.billing_type)
            return (
              <button
                type="button"
                data-target={tab.billing_type}
                aria-pressed={i === 0 ? 'true' : 'false'}
                aria-controls={`${idPrefix}-panel-${tab.billing_type}`}
                class:list={['pricing-tab', i === 0 && 'is-active']}
              >
                {TAB_LABELS[tab.billing_type] ?? tab.billing_type}
                {icon && (
                  <span class="shrink-0 w-5 h-5 flex items-center justify-center" set:html={sanitizeSvg(icon)} />
                )}
              </button>
            )
          })}
        </div>
      )
    }

    {
      displayTabs.map((tab, tabIndex) => (
        <div
          id={showTabs ? `${idPrefix}-panel-${tab.billing_type}` : undefined}
          data-panel={tab.billing_type}
          class:list={[
            'pricing-panel grid grid-cols-1 gap-6 items-start',
            // Literal branches, for the same extraction reason as `containerClass` above.
            width === 'wide' ? 'md:grid-cols-2 xl:grid-cols-4' : 'md:grid-cols-3',
            tabIndex > 0 && 'hidden',
          ]}
        >
          {tab.plans.map((plan) => {
            const features = plan.features ?? []
            return (
              <article class="pricing-card surface-light">
                {plan.size_label && <span class="pricing-chip">{plan.size_label}</span>}

                <h3 class="font-bold text-[24px] leading-[1.2]">{plan.name}</h3>

                {/* Decorative: the tier is already named by the chip and the heading above, so
                    an alt here would be read out twice. Hence the empty alt. */}
                {plan.plan_image && (
                  <img
                    class="pricing-plan-image"
                    src={plan.plan_image}
                    srcset={plan.plan_image_meta?.srcset ?? undefined}
                    width={plan.plan_image_meta?.width ?? undefined}
                    height={plan.plan_image_meta?.height ?? undefined}
                    alt=""
                    loading="lazy"
                  />
                )}

                {plan.description && (
                  <RichText class="text-[14px] leading-[1.6] text-text-secondary [&_p]:mb-0" html={plan.description} />
                )}

                {plan.badge && <span class="pricing-badge">{plan.badge}</span>}

                <div class="pricing-price">{plan.price ?? ''}</div>

                {plan.fine_print && <p class="text-[12px] text-text-secondary leading-[1.5]">{plan.fine_print}</p>}

                {plan.cta_label && plan.cta_href && (
                  <a href={hrefOf(plan.cta_href)} class="btn-primary justify-center mt-auto">
                    {plan.cta_label}
                  </a>
                )}

                {features.length > 0 && (
                  <details class="group mt-1">
                    <summary class="text-[14px] font-semibold cursor-pointer select-none flex justify-between items-center list-none">
                      See details
                      <svg
                        class="w-4 h-4 transition-transform duration-200 group-open:rotate-180"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                        stroke-width="2"
                        aria-hidden="true"
                      >
                        <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                      </svg>
                    </summary>
                    <ul class="list-none p-0 mt-3 flex flex-col gap-2 border-t border-gray-200 pt-3">
                      {features.map((feature) => (
                        <li class="text-[14px] text-text-secondary leading-[1.6]">
                          <span class="font-semibold text-text-primary">{feature.title}</span>
                          {feature.description && <span> — {feature.description}</span>}
                        </li>
                      ))}
                    </ul>
                  </details>
                )}
              </article>
            )
          })}
        </div>
      ))
    }

    {
      /* One class, both bands: a dark band re-maps `--color-text-secondary` to its own lighter
         grey (core/styles/tokens.css), so the per-band ternary this used to carry is gone. */
      body && (
        <p class="text-center max-w-[700px] mx-auto mt-12 text-[15px] leading-[1.7] text-text-secondary">
          {body}
        </p>
      )
    }
  </div>
</section>

{
  /* Tab switching, scoped per section so multiple pricing tables on one page don't collide;
     the data-tabs-init guard makes extra emitted copies (one per block instance) no-ops.
     Only pages with an actual tab bar ship any JS — same conditional is:inline pattern as
     Testimonials.astro (the emitted-verbatim set:html caveat documented there applies too). */
  showTabs && (
    <script
      is:inline
      set:html={`document.querySelectorAll('.section-pricing-table').forEach(function (section) {
        if (section.dataset.tabsInit) return
        section.dataset.tabsInit = '1'
        var buttons = section.querySelectorAll('.pricing-tabs [data-target]')
        buttons.forEach(function (button) {
          button.addEventListener('click', function () {
            buttons.forEach(function (b) {
              b.classList.toggle('is-active', b === button)
              b.setAttribute('aria-pressed', b === button ? 'true' : 'false')
            })
            section.querySelectorAll('.pricing-panel').forEach(function (p) { p.classList.add('hidden') })
            var target = section.querySelector('[data-panel="' + button.getAttribute('data-target') + '"]')
            if (target) target.classList.remove('hidden')
          })
        })
      })`}
    />
  )
}
