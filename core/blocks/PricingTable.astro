---
// Core pricing_table block (ref block): the API resolves the referenced `plan` items into
// `plans`, or — when `billing_toggle` is set — folds them into `tabs` grouped by each plan's
// `billing_type` (the backend group_by resolver). One tab renders at a time; the buttons
// switch panels with a few lines of script scoped to this section. Plan cards render
// size_label chip → tier illustration → name → description → badge → price → fine print →
// bundled sub_plans → CTA → collapsible feature list → example_logos row, every field optional.
//
// `width: 'wide'` swaps the page container for the one step past it — a four-card set does not
// fit the page measure without squeezing all four.
import type { PricingTableBlock, ResponsiveImageMeta } from '../../types/blocks'
import { sanitizeIcon } from '../../lib/sanitize'
import { sectionAnchorId } from '../../lib/anchor'
import RichText from '../RichText.astro'
import SectionHeader from '../SectionHeader.astro'
import { href as hrefOf } from '../../lib/href'
import { IMAGE_SIZES, responsiveImageAttrs } from '../../lib/image'
import { usableCtas } from '../../lib/ctas'
import { alignClass } from '../../lib/align'
import { backgroundClass } from '../../lib/background'
import { tabLabel } from '../../lib/tab-label'

interface Props {
  block: PricingTableBlock
}

const { block } = Astro.props
const {
  anchor_id,
  eyebrow,
  heading,
  intro,
  body,
  align,
  background,
  animation_url,
  width,
  description_height,
  price_size,
  billing_toggle,
  tabs,
  plans,
  tab_icons,
  tab_labels,
  ctas,
  heading_icon,
} = block.data

// Ungrouped payloads (billing_toggle off, or hand-authored fixtures) arrive as a flat
// `plans` list — normalize both shapes into a tab list so the template has one path.
const displayTabs = tabs ?? (plans ? [{ billing_type: '', plans }] : [])
const showTabs = !!billing_toggle && displayTabs.length > 1

const sectionId = sectionAnchorId(anchor_id)
const tabIcon = (billingType: string) => tab_icons?.find((icon) => icon.billing_type === billingType)?.icon_svg

// The button's name: this table's own `tab_labels` first, then core's default pair. Shared with
// any client override that renders this block — see lib/tab-label.ts.
const labelOf = (billingType: string) => tabLabel(billingType, tab_labels)

// Prefix for the tab-button ↔ panel aria-controls wiring. Derived from the anchor when set;
// two anchor-less pricing tables on one page would collide — give them anchors in the CMS.
const idPrefix = sectionId ?? 'pricing-table'

// A literal lookup, not an interpolated class: UnoCSS extracts class names from source text,
// so `container-${width}` would generate no CSS at all (see docs/starter.md).
const containerClass = width === 'wide' ? 'container-wide' : 'container-global'

// Literal branches for the same extraction reason. Both fields are overrides on top of the card's
// normal look, so an unset value adds no class and every table saved before they existed renders
// byte-identically (#1416).
const descriptionClass = description_height === 'fixed' ? 'pricing-description-fixed' : undefined
const priceClass = price_size === 'small' ? 'pricing-price-sm' : undefined

// The closing link(s) under `body`, half-filled rows dropped — see lib/ctas.ts, shared with the
// two other blocks fed by the same `$ctaList` shape.
const closingCtas = usableCtas(ctas)

// The shared `background` select, on the same helper as the five other blocks that carry it
// (#1498). It used to be a local `background === 'dark'` ternary here, paired with a shortcut that
// read "dark" as the client-editable SECONDARY brand color — white text on a white band for a
// client whose secondary is light. See lib/background.ts.
const bandClass = backgroundClass(background)
// The shared `align` select (#1643) — the header does the aligning, this is the site hook.
// See lib/align.ts.
const alignModifier = alignClass(align)

// `example_logos` is a `multiple` media field, so each element is the WHOLE MediaUrls.for() object
// ({ url, alt, width, height, srcset, … }) — NOT a bare URL, whatever BLOCKS.md's example still
// shows. A plain string is tolerated for hand-written fixtures, same as TeaserImage allows. These
// three readers are local rather than in lib/ on purpose: the field-coverage gate follows a `lib/`
// helper's source into its haystack, so moving the field read there would make the gate's hit on
// `example_logos` meaningless — and the source-walk test in tests/pricing-plan-fields.test.ts
// depends on the read being visible HERE (see that file's header).
const logoUrl = (logo: unknown): string | null => {
  if (typeof logo === 'string') return logo
  const url = (logo as { url?: unknown } | null)?.url
  return typeof url === 'string' && url !== '' ? url : null
}

// A logo's alt belongs to the MEDIUM, not the plan: it names the client, which the card cannot
// know. Empty string when absent — a logo strip is decorative until someone types the name, and an
// invented alt is worse than none.
const logoAlt = (logo: unknown): string => {
  const alt = (logo as { alt?: unknown } | null)?.alt
  return typeof alt === 'string' ? alt : ''
}

// The same object carries the responsive triple, so a logo gets its srcset for free. A bare-string
// fixture has none — hence null, which makes responsiveImageAttrs emit nothing and leave a plain
// `src`, exactly as before this existed. Same cast as SectionTeaser's `imageMeta`: MediaUrls'
// object is a structural superset of the triple, and the extra keys are simply never read.
const logoMeta = (logo: unknown): ResponsiveImageMeta | null =>
  logo && typeof logo === 'object' ? (logo as ResponsiveImageMeta) : null
---

<section id={sectionId} class:list={['section-pricing-table section-band py-20', bandClass, alignModifier]}>
  <div class={containerClass}>
    <SectionHeader headingIcon={heading_icon} {eyebrow} {heading} {intro} {align} animation={animation_url} />

    {
      showTabs && (
        <div class="pricing-tabs flex justify-center gap-3 mb-10">
          {displayTabs.map((tab, i) => {
            const icon = tabIcon(tab.billing_type)
            return (
              <button
                type="button"
                data-target={tab.billing_type}
                aria-pressed={i === 0 ? 'true' : 'false'}
                aria-controls={`${idPrefix}-panel-${tab.billing_type}`}
                class:list={['pricing-tab', i === 0 && 'is-active']}
              >
                {labelOf(tab.billing_type)}
                {/* `sanitizeIcon`, not `sanitizeSvg` (dashboard#1968 follow-up). Both authored-SVG
                    fields agreed on TYPE after #1968 and still disagreed on RENDER, so a tab icon
                    kept a hardcoded `fill` — wrong in a button whose text colour changes with
                    `is-active` — and kept its own `width`, which this 20px box has no rule to
                    contain. Free to correct: no client has a stored `tab_icons` value. The
                    `[&>svg]` pair is what the size strip leaves the box responsible for, the same
                    pairing the `section-heading-icon` shortcut makes. */}
                {icon && (
                  <span
                    class="shrink-0 w-5 h-5 flex items-center justify-center [&>svg]:w-full [&>svg]:h-full"
                    set:html={sanitizeIcon(icon)}
                  />
                )}
              </button>
            )
          })}
        </div>
      )
    }

    {
      displayTabs.map((tab, tabIndex) => (
        <div
          id={showTabs ? `${idPrefix}-panel-${tab.billing_type}` : undefined}
          data-panel={tab.billing_type}
          class:list={[
            'pricing-panel grid grid-cols-1 gap-6 items-start',
            // Literal branches, for the same extraction reason as `containerClass` above.
            width === 'wide' ? 'md:grid-cols-2 xl:grid-cols-4' : 'md:grid-cols-3',
            tabIndex > 0 && 'hidden',
          ]}
        >
          {tab.plans.map((plan) => {
            const features = plan.features ?? []
            // Where this plan's note goes. Absent means `under_price`, which is where this
            // renderer already printed every note, so no stored plan moves (#1416). The note
            // itself is built once — only its position varies, so its markup must not.
            const notePlacement = plan.fine_print_placement ?? 'under_price'
            const note = plan.fine_print ? <p class="pricing-fine-print">{plan.fine_print}</p> : null
            // Resolved ONCE per plan, and filtered BEFORE the length check the row is guarded on.
            // Guarding on the raw list would emit `pricing-logos` — `border-t … pt-4`, a visible
            // rule plus 1rem of padding — around nothing whenever every element's url failed to
            // resolve. Hoisting also stops the three readers running per element inside the map.
            // flatMap rather than map+filter so `url` narrows to a string for the <img> below —
            // a predicate-less filter leaves it `string | null` however plainly it reads.
            const logos = (plan.example_logos ?? []).flatMap((logo) => {
              const url = logoUrl(logo)
              return url ? [{ url, alt: logoAlt(logo), meta: logoMeta(logo) }] : []
            })
            return (
              <article class="pricing-card surface-light">
                {plan.size_label && <span class="pricing-chip">{plan.size_label}</span>}

                <h3 class="font-bold text-[24px] leading-[1.2]">{plan.name}</h3>

                {/* Decorative: the tier is already named by the chip and the heading above, so
                    an alt here would be read out twice. Hence the empty alt. */}
                {plan.plan_image && (
                  <img
                    class="pricing-plan-image"
                    src={plan.plan_image}
                    srcset={plan.plan_image_meta?.srcset ?? undefined}
                    width={plan.plan_image_meta?.width ?? undefined}
                    height={plan.plan_image_meta?.height ?? undefined}
                    alt=""
                    loading="lazy"
                  />
                )}

                {plan.description && (
                  <RichText
                    class:list={['text-[14px] leading-[1.6] text-text-secondary [&_p]:mb-0', descriptionClass]}
                    html={plan.description}
                  />
                )}

                {plan.badge && <span class="pricing-badge">{plan.badge}</span>}

                <div class:list={['pricing-price', priceClass]}>{plan.price ?? ''}</div>

                {notePlacement === 'under_price' && note}

                {/* The offers a bundle contains (`sub_plans`, #1288): a $790 card whose real content
                    is two fully-priced offers of its own. Placed BEFORE the CTA because the card's
                    button carries `mt-auto` — anything after it is pinned to the card's foot, and
                    these are plan CONTENT, so they belong in the flowing region beside the price
                    they qualify.

                    An indented <ul> rather than nested cards: the parent is already a card, and a
                    card inside a card needs surface/padding decisions core does not have. A list
                    for the same reason the feature list below is one — these are repeated peers,
                    and their count is a fact an assistive reader should hear. Each row
                    is name + price, since the price is the whole reason a sub-plan is listed apart
                    from a feature line. Always resolved records — the API drops ids that no longer
                    resolve — so there is no bare-number case to guard. */}
                {(plan.sub_plans ?? []).length > 0 && (
                  <ul class="pricing-sub-plans">
                    {(plan.sub_plans ?? []).map((sub) => (
                      <li class="pricing-sub-plan">
                        <div class="pricing-sub-plan-head">
                          <span class="pricing-sub-plan-name">{sub.name}</span>
                          {sub.price && <span class="pricing-sub-plan-price">{sub.price}</span>}
                        </div>
                        {sub.cta_label && sub.cta_href && (
                          <a href={hrefOf(sub.cta_href)} class="pricing-sub-plan-cta">
                            {sub.cta_label}
                          </a>
                        )}
                      </li>
                    ))}
                  </ul>
                )}

                {plan.cta_label && plan.cta_href && (
                  <a href={hrefOf(plan.cta_href)} class="btn-primary justify-center mt-auto">
                    {plan.cta_label}
                  </a>
                )}

                {notePlacement === 'under_button' && note}

                {/* `with_details` closes the feature list rather than following it: the note
                    qualifies what the plan contains, so it belongs with the lines it qualifies,
                    and where that list collapses behind a control the note collapses with it.
                    This is the fallback for a plan that has such a note but no list to put it in
                    — the list's own copy is inside the <details> below. */}
                {notePlacement === 'with_details' && features.length === 0 && note}

                {features.length > 0 && (
                  <details class="group mt-1">
                    <summary class="text-[14px] font-semibold cursor-pointer select-none flex justify-between items-center list-none">
                      See details
                      <svg
                        class="w-4 h-4 transition-transform duration-200 group-open:rotate-180"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                        stroke-width="2"
                        aria-hidden="true"
                      >
                        <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                      </svg>
                    </summary>
                    <ul class="list-none p-0 mt-3 flex flex-col gap-2 border-t border-border pt-3">
                      {features.map((feature) => (
                        <li class="text-[14px] text-text-secondary leading-[1.6]">
                          <span class="font-semibold text-text-primary">{feature.title}</span>
                          {feature.description && <span> — {feature.description}</span>}
                        </li>
                      ))}
                    </ul>

                    {notePlacement === 'with_details' && note}
                  </details>
                )}

                {/* `example_logos` — the client-mark row the source shows under a card. LAST, so it
                    lands at the card's foot below the feature list: the CTA's `mt-auto` puts
                    everything after it there, which is where a "who this is for" strip reads as
                    evidence for the whole card rather than as another content row.

                    Unlabelled on purpose. diligently.pl derives "Small package examples:" from the
                    card's own `size_label`, which is a good idea and that site's editorial voice —
                    core has no field for the phrase, and inventing English copy in a renderer is
                    not core's call to make. A site that wants the label adds it in its own override.

                    Elements are objects, so read `.url`/`.alt` through the helpers above; a logo
                    whose url does not resolve is dropped by the `logos` filter rather than emitted
                    as a broken <img> — which is also what keeps the row's top rule off a card whose
                    every logo failed. A <ul>, like the feature list above and like core's other
                    repeated media collections (Gallery, Team): a mark row is a list, and the count
                    is a fact worth announcing. */}
                {logos.length > 0 && (
                  <ul class="pricing-logos">
                    {logos.map((logo) => (
                      <li>
                        <img
                          class="pricing-logo"
                          src={logo.url}
                          alt={logo.alt}
                          loading="lazy"
                          {...responsiveImageAttrs(logo.meta, IMAGE_SIZES.planLogo)}
                        />
                      </li>
                    ))}
                  </ul>
                )}
              </article>
            )
          })}
        </div>
      ))
    }

    {
      /* One class, both bands: a dark band re-maps `--color-text-secondary` to its own lighter
         grey (core/styles/tokens.css), so the per-band ternary this used to carry is gone. */
      body && (
        <p class="text-center max-w-[700px] mx-auto mt-12 text-[15px] leading-[1.7] text-text-secondary">
          {body}
        </p>
      )
    }

    {
      /* The section's closing link(s), under that paragraph — outline rather than primary, so the
         plan cards' own buttons stay the section's main action (#1416). */
      closingCtas.length > 0 && (
        <div class="actions-row justify-center mt-8">
          {closingCtas.map((cta) => (
            <a href={hrefOf(cta.href)} class="btn-outline">
              {cta.label}
            </a>
          ))}
        </div>
      )
    }
  </div>
</section>

{
  /* Tab switching, scoped per section so multiple pricing tables on one page don't collide;
     the data-tabs-init guard makes extra emitted copies (one per block instance) no-ops.
     Only pages with an actual tab bar ship any JS — same conditional is:inline pattern as
     Testimonials.astro (the emitted-verbatim set:html caveat documented there applies too). */
  showTabs && (
    <script
      is:inline
      set:html={`document.querySelectorAll('.section-pricing-table').forEach(function (section) {
        if (section.dataset.tabsInit) return
        section.dataset.tabsInit = '1'
        var buttons = section.querySelectorAll('.pricing-tabs [data-target]')
        buttons.forEach(function (button) {
          button.addEventListener('click', function () {
            buttons.forEach(function (b) {
              b.classList.toggle('is-active', b === button)
              b.setAttribute('aria-pressed', b === button ? 'true' : 'false')
            })
            section.querySelectorAll('.pricing-panel').forEach(function (p) { p.classList.add('hidden') })
            var target = section.querySelector('[data-panel="' + button.getAttribute('data-target') + '"]')
            if (target) target.classList.remove('hidden')
          })
        })
      })`}
    />
  )
}
