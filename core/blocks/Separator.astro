---
// Core separator block — a centred rule, a full-width hairline, or three dots.
//
// The variant class is looked up from a literal map rather than interpolated (`separator-${style}`)
// for two reasons: UnoCSS extracts class names statically, so an interpolated one generates NO CSS
// at all, and a CMS value must never reach a class name unchecked. An unknown style falls back to
// the default rule instead of emitting a class nothing styles. The dots ride a
// `before:content-[...]` utility, so this block carries no CSS of its own.
import type { SeparatorBlock } from '../../types/blocks'

interface Props {
  block: SeparatorBlock
}

const VARIANTS = {
  default: 'separator-default',
  wide: 'separator-wide',
  dots: 'separator-dots',
} as const

const { block } = Astro.props
const variant = VARIANTS[block.data.style as keyof typeof VARIANTS] ?? VARIANTS.default
---

<div class="section-separator">
  <hr class:list={['separator', variant]} />
</div>
