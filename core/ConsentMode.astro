---
// Consent Mode v2 bootstrap + analytics loader (#521). Mount this in <head>, BEFORE any other
// analytics. It SELF-GATES: it emits nothing unless the client both enabled cookie consent
// (Settings → Privacy) AND has a Google Tag or GA4 id configured (Integrations). With consent
// off, a build contains zero analytics — the shipped default.
//
// Ordering is the whole point: `consent 'default' = denied` runs first, a prior "accept" is
// replayed from localStorage, and only then does the GTM/GA4 tag load — so nothing is measured
// until the visitor has consented (CookieConsent.astro flips it to granted on accept).
//
// Which id ends up where — and which id is refused, with a build-log line saying why — is
// core/analytics.ts, shared with CookieConsent.astro so the banner and the tag can never
// disagree about whether this site measures anything.
//
// The <noscript> half of the stock GTM snippet is ConsentModeNoscript.astro, mounted at the start
// of <body> — no component can render into both places. Keep the two mounted together.
import { getSiteSettings } from '../lib/api'
import { resolveAnalytics, warnAboutAnalytics } from './analytics'

const settings = await getSiteSettings()
const analytics = resolveAnalytics(settings)

// One line per build when a configured id is dropped or gated — the two ways this feature fails
// silently from the outside.
warnAboutAnalytics(analytics)

const { active, gtmId, gtagId } = analytics

const STORAGE_KEY = 'cookie-consent'

const bootstrap = `
window.dataLayer = window.dataLayer || [];
function gtag(){ dataLayer.push(arguments); }
window.gtag = gtag;
gtag('consent','default',{ad_storage:'denied',ad_user_data:'denied',ad_personalization:'denied',analytics_storage:'denied'});
try { if (localStorage.getItem('${STORAGE_KEY}') === 'accepted') gtag('consent','update',{analytics_storage:'granted'}); } catch(e){}
gtag('js', new Date());
`.trim()

// Prefer GTM when both are set (a GTM container usually already hosts the GA4 tag).
const gtmLoader = gtmId
  ? `(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer','${gtmId}');`
  : null

const gtagOnly = !gtmId && gtagId ? gtagId : null
---

{
  active && (
    <>
      <script is:inline set:html={bootstrap} />
      {gtmLoader && <script is:inline set:html={gtmLoader} />}
      {gtagOnly && (
        <>
          <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gtagOnly}`} />
          <script is:inline set:html={`gtag('config','${gtagOnly}');`} />
        </>
      )}
    </>
  )
}
